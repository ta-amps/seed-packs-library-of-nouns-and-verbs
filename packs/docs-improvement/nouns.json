{"store": "seedpack.docs-improvement", "key": "docs-improvement.v0.1.0.doc-rubric", "expected_version": 0, "producer_surface": "surface:tessera", "visibility_scope": "surface_only", "allowed_surfaces": [], "target_cohorts": ["all"], "tags": ["category:noun.benchmark_suite", "pack:docs-improvement", "role:rubric", "content:authored", "spdx:MIT", "status:quarantined"], "value": {"category_id": "noun.benchmark_suite", "role": "rubric", "pack": "docs-improvement", "pack_version": "0.1.0", "title": "Documentation rubric: eight criteria", "category_reason": "A fixed scoring rubric every audit and review uses.", "criteria": [{"id": "first-screen", "asks": "The first screen says who it is for, what it does and how to try it.", "evidence": "Quote the first 30 lines and name what is missing."}, {"id": "one-reading-order", "asks": "A newcomer can tell which page to read first and next.", "evidence": "List entry pages and the order each one gives."}, {"id": "task-coverage", "asks": "The first tasks readers try each have a page.", "evidence": "Map likely first tasks to pages."}, {"id": "runnable-examples", "asks": "Copy-paste examples run as written.", "evidence": "Run each code block in a sandbox and record pass, fail or not runnable."}, {"id": "plain-language", "asks": "Sentences are short, terms are defined where first used, and outcomes come before mechanisms.", "evidence": "Quote the worst passages with a plain rewrite."}, {"id": "honest-status", "asks": "Claims about what works match the evidence; dated status beats timeless claims.", "evidence": "Cite each stale or unsupported claim and the evidence that contradicts it."}, {"id": "working-links", "asks": "Local links resolve and external links name what they point to.", "evidence": "List broken local links; external links are checked only when allowed."}, {"id": "accessible-structure", "asks": "Headings are in order, images have text alternatives and tables have headers.", "evidence": "List each structural problem with its location."}], "levels": {"good": "Meets the criterion with no material gap.", "needs_work": "A gap a reader would notice; fixable in place.", "broken": "Misleads readers or blocks a first task."}, "rules": ["Judge for the named reader, not for the author.", "A rewrite keeps every fact, command and number; it changes words, order and structure.", "Status claims need evidence with a date."], "status": "proposal", "admission": "not_admitted", "content_kind": "authored_guidance", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "reason": "Tessera requires these axes, so each is set to its lowest value and the tier is unverified. No quality is claimed. Replace them only with measured values and the evidence that produced them."}, "relations": []}},
