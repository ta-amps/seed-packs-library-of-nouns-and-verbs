    {
      "slug": "doc-rubric",
      "category": "noun.benchmark_suite",
      "role": "rubric",
      "title": "Documentation rubric: eight criteria",
      "category_reason": "A fixed scoring rubric every audit and review uses.",
      "value": {
        "criteria": [
          {
            "id": "first-screen",
            "asks": "The first screen says who it is for, what it does and how to try it.",
            "evidence": "Quote the first 30 lines and name what is missing."
          },
          {
            "id": "one-reading-order",
            "asks": "A newcomer can tell which page to read first and next.",
            "evidence": "List entry pages and the order each one gives."
          },
          {
            "id": "task-coverage",
            "asks": "The first tasks readers try each have a page.",
            "evidence": "Map likely first tasks to pages."
          },
          {
            "id": "runnable-examples",
            "asks": "Copy-paste examples run as written.",
            "evidence": "Run each code block in a sandbox and record pass, fail or not runnable."
          },
          {
            "id": "plain-language",
            "asks": "Sentences are short, terms are defined where first used, and outcomes come before mechanisms.",
            "evidence": "Quote the worst passages with a plain rewrite."
          },
          {
            "id": "honest-status",
            "asks": "Claims about what works match the evidence; dated status beats timeless claims.",
            "evidence": "Cite each stale or unsupported claim and the evidence that contradicts it."
          },
          {
            "id": "working-links",
            "asks": "Local links resolve and external links name what they point to.",
            "evidence": "List broken local links; external links are checked only when allowed."
          },
          {
            "id": "accessible-structure",
            "asks": "Headings are in order, images have text alternatives and tables have headers.",
            "evidence": "List each structural problem with its location."
          }
        ],
        "levels": {
          "good": "Meets the criterion with no material gap.",
          "needs_work": "A gap a reader would notice; fixable in place.",
          "broken": "Misleads readers or blocks a first task."
        },
        "rules": [
          "Judge for the named reader, not for the author.",
          "A rewrite keeps every fact, command and number; it changes words, order and structure.",
          "Status claims need evidence with a date."
        ]
      }
    },
