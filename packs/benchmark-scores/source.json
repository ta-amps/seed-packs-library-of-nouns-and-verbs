{
  "pack_id": "benchmark-scores",
  "title": "Benchmark scores",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for keeping benchmark scores current and comparable: scores with source, date, hardware, setup and method, daily refresh, deterministic staleness flags, checks on our own hardware and a daily schedule proposal that is not activated.",
  "dependencies": [
    "evaluation-design"
  ],
  "boundaries": [
    "Read only public pages and permitted exports. Do not sign up, log in, submit results or contact anyone.",
    "No scheduler is activated; the daily refresh is a proposal noun.",
    "Importing the pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for keeping benchmark scores current and comparable",
      "value": {
        "lets_workers": "Keep a set of benchmark scores you care about current and honest: record every score with its source, date, hardware, setup and method, refresh them daily, flag the stale ones, and check important claims on your own hardware.",
        "flow": [
          {
            "verb": {
              "$verb": "benchmark-scores.collect-scores"
            },
            "when": "When a watched benchmark or subject has a new reported score."
          },
          {
            "verb": {
              "$verb": "benchmark-scores.refresh-scores"
            },
            "when": "Daily, from the schedule proposal: re-read each watched score's source."
          },
          {
            "verb": {
              "$verb": "benchmark-scores.flag-stale"
            },
            "when": "Daily after refresh; deterministic, and it proposes refresh or comparison verbs."
          },
          {
            "verb": {
              "$verb": "benchmark-scores.compare-on-profile"
            },
            "when": "For claims that could change a decision; two runs on your hardware."
          },
          {
            "verb": {
              "$verb": "benchmark-scores.situate-score"
            },
            "when": "When a new score may agree or disagree with earlier ones."
          }
        ],
        "schedule": {
          "$pin": "schedule.daily-refresh"
        },
        "rule": "A score never stands alone: no source, date, setup and method means it cannot be compared."
      },
      "relations": [
        [
          "requires_noun",
          "method"
        ],
        [
          "requires_noun",
          "staleness-policy"
        ],
        [
          "requires_noun",
          "example.staleness"
        ],
        [
          "requires_noun",
          "schedule.daily-refresh"
        ],
        [
          "requires_noun",
          "template.score"
        ],
        [
          "requires_noun",
          "template.benchmark"
        ],
        [
          "requires_noun",
          "template.watch-list"
        ],
        [
          "requires_noun",
          "template.comparison"
        ],
        [
          "requires_noun",
          "template.staleness-report"
        ]
      ]
    },
    {
      "slug": "method",
      "category": "noun.skill_pack",
      "role": "method",
      "title": "Comparing benchmark scores honestly",
      "category_reason": "A reusable method with guardrails for every verb in this pack.",
      "value": {
        "rules": [
          "Two scores are comparable only with the same benchmark version, split and metric definition, and a known setup.",
          "Keep who reported a score: vendor, paper, leaderboard, community or our own run.",
          "Unknown setup fields stay null; a missing hardware field makes a score unverified, not wrong.",
          "Our own reproduction runs twice under committed pass marks, on the pinned profile's hardware.",
          "Never average unrelated leaderboards into one number.",
          "Read only public pages and permitted exports. Do not sign up, log in, submit results or contact anyone."
        ],
        "reproduction_method": {
          "$pin": "evaluation-design:method"
        }
      },
      "relations": [
        [
          "requires_noun",
          "evaluation-design:method"
        ]
      ]
    },
    {
      "slug": "staleness-policy",
      "category": "noun.reflex_procedure",
      "role": "staleness_policy",
      "title": "Staleness policy: when a benchmark score needs refreshing",
      "category_reason": "A zero-call deterministic rule: the same scores and date always give the same flags.",
      "value": {
        "max_age_days": {
          "vendor": 30,
          "leaderboard": 30,
          "community": 30,
          "paper": 90,
          "our_run": 60
        },
        "contradiction_tolerance_ratio": 0.1,
        "flags": {
          "older_than_max_age": "The score was observed longer ago than its reporter's max age.",
          "subject_changed": "The subject now has a newer exact version than the one scored.",
          "benchmark_changed": "The benchmark now has a newer version than the one scored.",
          "contradicted_by_our_run": "Our own run differs from the claim by more than the tolerance ratio.",
          "missing_setup": "The hardware is unknown, so the score cannot be compared with ours."
        },
        "status_rule": "contradicted if contradicted_by_our_run; otherwise stale if older_than_max_age, subject_changed or benchmark_changed; otherwise unverified if missing_setup; otherwise current.",
        "model_calls": 0
      }
    },
