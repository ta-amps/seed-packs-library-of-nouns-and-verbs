{
  "pack_id": "taste-palettes",
  "title": "Taste palettes",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for comparing options side by side and keeping a person's choice: several versions of one brief with adjustable settings, a choice recorded as a preference noun, and later work that uses it within its scope.",
  "dependencies": [],
  "boundaries": [
    "Only a person records a choice; silence is never a preference.",
    "Preferences belong to the person who chose and are used only within their scope.",
    "Importing the pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for comparing options side by side and keeping a person's choice",
      "value": {
        "lets_workers": "Show a person a few versions of one brief side by side, each made with different adjustable settings, record which one they choose as a preference, and use that preference in later work, through any surface that can show the comparison.",
        "flow": [
          {
            "verb": {
              "$verb": "taste-palettes.draft-embodiments"
            },
            "when": "Once per option, as separate attempts with different settings."
          },
          {
            "verb": {
              "$verb": "taste-palettes.assemble-comparison"
            },
            "when": "After two to four options exist; deterministic."
          },
          {
            "verb": {
              "$verb": "taste-palettes.record-choice"
            },
            "when": "A person chooses, or chooses none; any surface can show the sheet."
          },
          {
            "verb": {
              "$verb": "taste-palettes.update-preferences"
            },
            "when": "After each choice: does it agree with earlier ones?"
          },
          {
            "verb": {
              "$verb": "taste-palettes.apply-preference"
            },
            "when": "In later work, when a pinned preference is in scope."
          }
        ],
        "surface_note": "The comparison sheet is plain data. A website, app, chat client or CLI can show it; none of them stores the choice except through record-choice.",
        "method": {
          "$pin": "method"
        }
      },
      "relations": [
        [
          "requires_noun",
          "method"
        ],
        [
          "requires_noun",
          "template.brief"
        ],
        [
          "requires_noun",
          "template.embodiment"
        ],
        [
          "requires_noun",
          "template.comparison-sheet"
        ],
        [
          "requires_noun",
          "template.preference"
        ],
        [
          "requires_noun",
          "template.preference-summary"
        ],
        [
          "requires_noun",
          "example.readme-tone"
        ]
      ]
    },
    {
      "slug": "method",
      "category": "noun.skill_pack",
      "role": "method",
      "title": "How to make palettes that teach something",
      "category_reason": "A reusable method with its guardrails for every palette.",
      "value": {
        "rules": [
          "Change one to three settings at a time and hold everything else fixed, so a choice says something specific.",
          "Show two to four options. Always allow none of these.",
          "Label differences in plain words, such as calmer or more compact, not internal setting names.",
          "Shuffle option order with a recorded seed so position does not decide.",
          "Never infer a preference from silence or from a person's other data.",
          "A preference is scoped to a medium and a use, and it can be contradicted by later choices."
        ],
        "confidence_rule": "One choice gives low confidence; agreement across three or more comparable choices gives high confidence; any contradiction caps confidence at medium until resolved.",
        "privacy": "Preferences belong to the person who chose. Keep them with the person who chose and never use them outside their scope."
      }
    },
