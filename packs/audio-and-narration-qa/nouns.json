{"store": "seedpack.audio-and-narration-qa", "key": "audio-and-narration-qa.v0.1.0.tool.audio-narration-qa", "expected_version": 0, "producer_surface": "surface:tessera", "visibility_scope": "surface_only", "allowed_surfaces": [], "target_cohorts": ["all"], "tags": ["category:noun.code_node", "pack:audio-and-narration-qa", "role:tool_card", "content:authored", "spdx:MIT", "status:quarantined"], "value": {"category_id": "noun.code_node", "role": "tool_card", "pack": "audio-and-narration-qa", "pack_version": "0.1.0", "title": "Tool card: standard-library audio and narration QA analyzer", "category_reason": "Tested Python standard-library package pinned by path, file count and digest.", "name": "audio and narration QA", "code": {"path": "packs/audio-and-narration-qa/code", "files": 10, "sha256": "d54a4a6f316cb14030b6ac49b39a23f28cd9fc41608a397986afde8f8a20f2ba"}, "runtime": "Python 3.10 or later, standard library only.", "commands": ["python -m audio_narration_qa loudness --wav FILE [--target-lufs -16.0]", "python -m audio_narration_qa dynamics --mix-wav FILE [--music-wav FILE] --phrases-json FILE", "python -m audio_narration_qa pacing --vtt FILE --phrases-json FILE --duration-s S", "python -m audio_narration_qa cer --reference SCRIPT.txt --hypothesis ASR.txt"], "does": ["Computes BS.1770-4 K-weighted gated LUFS, 3 s LRA, sample peak and 4x windowed-sinc true peak.", "Detects sidechain pause-pumping in 0.3 to 1.0 s pauses, builds 1.2 s hold-bridged duck envelopes, and detects edit-point clicks.", "Measures speaking and articulation WPM, 10 s pacing windows, WebVTT caption-pause sync and normalized Levenshtein ASR CER."], "does_not": ["Call remote APIs, run speech synthesis, modify source media or approve mixes without human listening."], "code_license": "MIT", "status": "proposal", "admission": "not_admitted", "content_kind": "authored_guidance", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "reason": "Tessera requires these axes, so each is set to its lowest value and the tier is unverified. No quality is claimed. Replace them only with measured values and the evidence that produced them."}, "relations": [{"relation": "verifies", "target_id": "seedpack.audio-and-narration-qa/audio-and-narration-qa.v0.1.0.spec.audio-narration-gates", "target_category": "noun.benchmark_suite", "note": ""}]}},
