.skill_pack", "note": ""}, {"relation": "requires_noun", "target_id": "seedpack.audio-and-narration-qa/audio-and-narration-qa.v0.1.0.guardrail.metrics-not-creative-approval", "target_category": "noun.skill_pack", "note": ""}, {"relation": "requires_noun", "target_id": "seedpack.audio-and-narration-qa/audio-and-narration-qa.v0.1.0.spec.audio-narration-gates", "target_category": "noun.benchmark_suite", "note": ""}, {"relation": "requires_noun", "target_id": "seedpack.audio-and-narration-qa/audio-and-narration-qa.v0.1.0.rules.hold-ducking-envelope", "target_category": "noun.reflex_procedure", "note": ""}, {"relation": "requires_noun", "target_id": "seedpack.audio-and-narration-qa/audio-and-narration-qa.v0.1.0.tool.audio-narration-qa", "target_category": "noun.code_node", "note": ""}, {"relation": "requires_noun", "target_id": "seedpack.audio-and-narration-qa/audio-and-narration-qa.v0.1.0.template.narration-qa-report", "target_category": "noun.scene_recipe", "note": ""}]}},
