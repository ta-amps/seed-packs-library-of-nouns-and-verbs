{"store": "seedpack.audio-and-narration-qa", "key": "audio-and-narration-qa.v0.1.0.pack", "expected_version": 0, "producer_surface": "surface:tessera", "visibility_scope": "surface_only", "allowed_surfaces": [], "target_cohorts": ["all"], "tags": ["category:noun.skill_pack", "pack:audio-and-narration-qa", "role:pack", "content:authored", "spdx:MIT", "status:quarantined"], "value": {"category_id": "noun.skill_pack", "role": "pack", "pack": "audio-and-narration-qa", "pack_version": "0.1.0", "title": "A collection of nouns and verbs for deterministic audio, mix and narration quality checks", "lets_workers": "Measure ITU-R BS.1770-4 integrated loudness, loudness range and 4x oversampled inter-sample true peak, detect sidechain pause-pumping in short speech gaps and generate hold-bridged duck envelopes, flag edit-point splice clicks via second-difference impulse concentration, check speaking WPM pacing and WebVTT caption-pause sync, and gate synthesized or recorded speech against its script with normalized Levenshtein CER.", "flow": [{"verb": "audio-and-narration-qa.measure-loudness-and-peaks", "when": "Measure BS.1770-4 integrated LUFS, LRA, sample peak and 4x true peak."}, {"verb": "audio-and-narration-qa.audit-ducking-and-clicks", "when": "Check music stems and mixes for sidechain pause-pumping and edit-point splice clicks."}, {"verb": "audio-and-narration-qa.check-pacing-and-caption-sync", "when": "Verify speaking WPM, 10 s sliding pacing windows, and WebVTT caption onset/offset alignment."}, {"verb": "audio-and-narration-qa.gate-narration-asr-cer", "when": "Compare ASR transcript against the reference script using normalized CER."}, {"verb": "audio-and-narration-qa.compile-narration-qa-report", "when": "Bind all audio and narration metrics into a single QA report."}], "guardrails": [{"store": "seedpack.audio-and-narration-qa", "key": "audio-and-narration-qa.v0.1.0.guardrail.exact-audio-digest", "version": 1, "value_sha256": "8bf63ed218755f4858aa02af2670d233309d0a278