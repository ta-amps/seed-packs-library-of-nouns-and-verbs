{"store": "seedpack.audio-and-narration-qa", "key": "audio-and-narration-qa.v0.1.0.guardrail.hold-across-short-pauses", "expected_version": 0, "producer_surface": "surface:tessera", "visibility_scope": "surface_only", "allowed_surfaces": [], "target_cohorts": ["all"], "tags": ["category:noun.skill_pack", "pack:audio-and-narration-qa", "role:guardrail", "content:authored", "spdx:MIT", "status:quarantined"], "value": {"category_id": "noun.skill_pack", "role": "guardrail", "pack": "audio-and-narration-qa", "pack_version": "0.1.0", "title": "Guardrail: bridge pauses shorter than 1.2 s so music ducking never pumps between clauses", "category_reason": "Prevents distracting background swells inside comma and sentence pauses.", "rule": "Music under narration holds a steady duck depth across pauses shorter than 1.2 s instead of releasing on every word boundary via a fast sidechain compressor.", "how_it_is_checked": "detect_pause_pumping flags pauses of 0.3 to 1.0 s whose 100 ms music level rises 3.0 dB or more above the preceding 0.6 s baseline.", "status": "proposal", "admission": "not_admitted", "content_kind": "authored_guidance", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "reason": "Tessera requires these axes, so each is set to its lowest value and the tier is unverified. No quality is claimed. Replace them only with measured values and the evidence that produced them."}, "relations": []}},
