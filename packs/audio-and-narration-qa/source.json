  "verbs": [
    {
      "slug": "measure-loudness-and-peaks",
      "kind": "verb.verify_gate",
      "title": "Measure BS.1770-4 loudness, LRA and 4x true peak",
      "claimant": "agent",
      "model_use": "none",
      "summary": "Filter 48 kHz PCM audio with the ITU-R BS.1770-4 K-weighting cascade, compute gated integrated LUFS, 3-second loudness range, sample peak and 4x oversampled true peak, and check them against delivery targets.",
      "outcome": "Loudness, LRA and true-peak measurements with any target or ceiling findings.",
      "ready_outcome": "loudness_measured",
      "pinned": [
        "spec.audio-narration-gates",
        "tool.audio-narration-qa",
        "guardrail.exact-audio-digest"
      ],
      "slots": [
        {
          "name": "audio_asset",
          "category": "noun.scene_recipe",
          "description": "Pin of the local WAV PCM asset and delivery target."
        }
      ],
      "network": [
        "local_only",
        "Reads local WAV bytes only."
      ],
      "produces": [
        {
          "name": "loudness_metrics",
          "template": "template.narration-qa-report"
        }
      ],
      "steps": [
        "Run python -m audio_narration_qa loudness on the local PCM file.",
        "Record SHA-256, integrated LUFS, LRA, sample peak and 4x true peak alongside any threshold violations."
      ],
      "acceptance": [
        {
          "id": "digest-bound",
          "check": "sha256 matches the exact PCM file read.",
          "method": "deterministic"
        },
        {
          "id": "bs1770-gated",
          "check": "evaluate_loudness reproduces integrated_lufs and true_peak_dbtp.",
          "method": "deterministic"
        }
      ]
    },
    {
      "slug": "audit-ducking-and-clicks",
      "kind": "verb.verify_gate",
      "title": "Detect sidechain pause-pumping and edit-point splice clicks",
      "claimant": "agent",
      "model_use": "none",
      "summary": "Measure 100 ms music loudness across 0.3 to 1.0 s pauses to catch sidechain release pumping, compute a 1.2 s hold-bridged duck envelope, and scan second-difference energy concentration for edit-point clicks.",
      "outcome": "Pause-pumping events, recommended duck envelope points and edit-point click timestamps.",
      "ready_outcome": "dynamics_audited",
      "pinned": [
        "spec.audio-narration-gates",
        "rules.hold-ducking-envelope",
        "tool.audio-narration-qa",
        "guardrail.hold-across-short-pauses"
      ],
      "slots": [
        {
          "name": "audio_stems",
          "category": "noun.scene_recipe",
          "description": "Pin of the local mix and music stems plus speech phrase spans."
        }
      ],
      "network": [
        "local_only",
        "Reads local stems and phrase timestamps without network access."
      ],
      "produces": [
        {
          "name": "dynamics_metrics",
          "template": "template.narration-qa-report"
        }
      ],
      "steps": [
        "Run detect_pause_pumping on the music K-weighted power trace and phrase spans.",
        "Generate a hold-bridged duck envelope with build_hold_duck_envelope when pumping is found.",
        "Run detect_edit_point_clicks on the mono waveform outside voiced spans."
      ],
      "acceptance": [
        {
          "id": "pumping-checked",
          "check": "Every pause in [0.3, 1.0) s is evaluated against the 3.0 dB rise limit.",
          "method": "deterministic"
        },
        {
          "id": "clicks-checked",
          "check": "Second-difference impulses >= 12x local median RMS with >= 0.5 concentration are reported.",
          "method": "deterministic"
        }
      ]
    },
    {
      "slug": "check-pacing-and-caption-sync",
      "kind": "verb.verify_gate",
      "title": "Check speaking WPM pacing and WebVTT caption-pause alignment",
      "claimant": "agent",
      "model_use": "none",
      "summary": "Parse WebVTT cues, compute overall speaking WPM, articulation WPM and 10-second sliding-window pacing, verify 95 percent voiced-frame caption coverage, and flag cue starts or ends drifting into pauses.",
      "outcome": "Speaking rate metrics, cue sync errors and voiced-frame coverage.",
      "ready_outcome": "pacing_and_captions_checked",
      "pinned": [
        "spec.audio-narration-gates",
        "tool.audio-narration-qa"
      ],
      "slots": [
        {
          "name": "captions_and_phrases",
          "category": "noun.scene_recipe",
          "description": "Pin of the WebVTT sidecar and measured speech phrase spans."
