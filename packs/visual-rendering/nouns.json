{"store": "seedpack.visual-rendering", "key": "visual-rendering.v0.1.0.quality-checks", "expected_version": 0, "producer_surface": "surface:tessera", "visibility_scope": "surface_only", "allowed_surfaces": [], "target_cohorts": ["all"], "tags": ["category:noun.benchmark_suite", "pack:visual-rendering", "role:quality_checks", "content:authored", "spdx:MIT", "status:quarantined"], "value": {"category_id": "noun.benchmark_suite", "role": "quality_checks", "pack": "visual-rendering", "pack_version": "0.1.0", "title": "Render quality checks and thresholds", "category_reason": "A fixed set of checks with thresholds and methods that every render is scored against.", "checks": [{"id": "dimensions-and-frames", "threshold": "Exact canvas width and height; frame count equals fps times duration, plus or minus one.", "method": "ffprobe or image headers."}, {"id": "color-space", "threshold": "The declared color space, sRGB unless the recipe says otherwise.", "method": "Read the output's color metadata."}, {"id": "empty-frames", "threshold": "No fully transparent or single-color frame unless the recipe declares it.", "method": "Per-frame pixel statistics."}, {"id": "repeatability", "threshold": "Two renders give identical digests for deterministic renderers, or SSIM of at least 0.99 for GPU renderers that are not bit-exact.", "method": "Render twice; compare digests or run ffmpeg's ssim filter."}, {"id": "text-contrast", "threshold": "Text contrast at least 4.5:1, or 3:1 for text 24 px and larger, against what is behind it.", "method": "WCAG relative luminance, as in example.contrast."}, {"id": "text-size", "threshold": "Overlay text at least 24 px tall at 1080p.", "method": "Font size from the recipe, scaled to the canvas."}, {"id": "safe-area", "threshold": "Every element inside the inner 90 percent of the canvas.", "method": "Element bounds from the recipe and the render."}, {"id": "missing-resources", "threshold": "The renderer log reports no missing texture, font or file.", "method": "Scan the render log."}, {"id": "render-budget", "threshold": "Wall time within the brief's budget.", "method": "The render manifest's wall_seconds."}, {"id": "asset-licenses", "threshold": "Every asset's license is allowed by the asset policy.", "method": "Deterministic join of elements and asset nouns."}, {"id": "reduced-motion", "threshold": "Every motion profile names a reduced-motion alternative.", "method": "Read the motion profiles."}], "rules": ["Every check reports its measurement.", "not_run and not_applicable always carry a reason; neither counts as pass.", "passed is true only if every check is pass or not_applicable."], "contrast_example": {"store": "seedpack.visual-rendering", "key": "visual-rendering.v0.1.0.example.contrast", "version": 1, "value_sha256": "34c7857c9c7681525a155e1b5c72c7f2a133ce48b16b9e5eb3bf71164409c34c"}, "status": "proposal", "admission": "not_admitted", "content_kind": "authored_guidance", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "reason": "Tessera requires these axes, so each is set to its lowest value and the tier is unverified. No quality is claimed. Replace them only with measured values and the evidence that produced them."}, "relations": [{"relation": "requires_noun", "target_id": "seedpack.visual-rendering/visual-rendering.v0.1.0.example.contrast", "target_category": "noun.benchmark_suite", "note": ""}]}},
{"store": "seedpack.visual-rendering", "key": "visual-rendering.v0.1.0.example.contrast", "expected_version": 0, "producer_surface": "surface:tessera", "visibility_scope": "surface_only", "allowed_surfaces": [], "target_cohorts": ["all"], "tags": ["category:noun.benchmark_suite", "pack:visual-rendering", "role:worked_example", "synthetic:true", "spdx:MIT", "status:quarantined"], "value": {"category_id": "noun.benchmark_suite", "role": "worked_example", "pack": "visual-rendering", "pack_version": "0.1.0", "title": "SYNTHETIC worked example: text contrast ratios", "category_reason": "A golden fixture with reference values that the validator recomputes.", "fixture_kind": "contrast_ratio", "formula": "Relative luminance L = 0.2126 R + 0.7152 G + 0.0722 B of linearized sRGB channels (c/12.92 at or below 0.04045, else ((c + 0.055) / 1.055) ^ 2.4); ratio = (L_lighter + 0.05) / (L_darker + 0.05).", "thresholds": {"normal_text": 4.5, "large_text": 3.0}, "pairs": [{"id": "white-on-black", "foreground": "#ffffff", "background": "#000000"}, {"id": "gray-767676-on-white", "foreground": "#767676", "background": "#ffffff"}, {"id": "gray-777777-on-white", "foreground": "#777777", "background": "#ffffff"}, {"id": "yellow-on-white", "foreground": "#ffff00", "background": "#ffffff"}, {"id": "blue-on-white", "foreground": "#0000ff", "background": "#ffffff"}], "expected": {"white-on-black": {"ratio": 21.0, "normal_text": true, "large_text": true}, "gray-767676-on-white": {"ratio": 4.54, "normal_text": true, "large_text": true}, "gray-777777-on-white": {"ratio": 4.48, "normal_text": false, "large_text": true}, "yellow-on-white": {"ratio": 1.07, "normal_text": false, "large_text": false}, "blue-on-white": {"ratio": 8.59, "normal_text": true, "large_text": true}}, "reading": ["The expected ratios are the widely published reference values for these color pairs.", "#767676 is the lightest gray that passes 4.5:1 on white; #777777 just misses it."], "status": "proposal", "admission": "not_admitted", "content_kind": "synthetic_example", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "reason": "Tessera requires these axes, so each is set to its lowest value and the tier is unverified. No quality is claimed. Replace them only with measured values and the evidence that produced them."}, "relations": []}},
