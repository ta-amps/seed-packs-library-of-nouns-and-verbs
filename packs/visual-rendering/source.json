{
  "pack_id": "visual-rendering",
  "title": "Visual and 3D rendering",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for rendering images, motion graphics and 3D scenes and checking the results: renderer cards, scene, asset and motion recipes, quality checks with a contrast worked example, and verbs to plan, prepare, render, check and review.",
  "dependencies": [
    "video-motion",
    "video-showcase"
  ],
  "boundaries": [
    "Keep every output in the requester's scope. Releasing anything is the owner's separate decision.",
    "Rendering uses no model per frame.",
    "Importing the pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for rendering images, motion graphics and 3D scenes and checking the results",
      "value": {
        "lets_workers": "Turn a visual brief into a scene recipe, assets and motion written as code, render it deterministically, check it automatically for size, frames, contrast, safe areas, missing resources and licenses, and have someone else review it.",
        "flow": [
          {
            "verb": {
              "$verb": "visual-rendering.plan-scene"
            },
            "when": "First, from a brief."
          },
          {
            "verb": {
              "$verb": "visual-rendering.prepare-assets"
            },
            "when": "For assets the scene needs: procedural, from licensed files, or generated and labeled."
          },
          {
            "verb": {
              "$verb": "visual-rendering.render"
            },
            "when": "After the recipe and assets exist; no model per frame."
          },
          {
            "verb": {
              "$verb": "visual-rendering.check-render"
            },
            "when": "After each render; deterministic."
          },
          {
            "verb": {
              "$verb": "visual-rendering.review-render"
            },
            "when": "Last, by a person or a different worker."
          }
        ],
        "motion_as_code": "Motion graphics are scene recipes whose elements reference motion profiles: easing, duration, keyframes and a reduced-motion alternative.",
        "quality_checks": {
          "$pin": "quality-checks"
        }
      },
      "relations": [
        [
          "requires_noun",
          "quality-checks"
        ],
        [
          "requires_noun",
          "example.contrast"
        ],
        [
          "requires_noun",
          "tool.blender"
        ],
        [
          "requires_noun",
