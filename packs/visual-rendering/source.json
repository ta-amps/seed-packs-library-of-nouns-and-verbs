        ]
      ]
    },
    {
      "slug": "quality-checks",
      "category": "noun.benchmark_suite",
      "role": "quality_checks",
      "title": "Render quality checks and thresholds",
      "category_reason": "A fixed set of checks with thresholds and methods that every render is scored against.",
      "value": {
        "checks": [
          {
            "id": "dimensions-and-frames",
            "threshold": "Exact canvas width and height; frame count equals fps times duration, plus or minus one.",
            "method": "ffprobe or image headers."
          },
          {
            "id": "color-space",
            "threshold": "The declared color space, sRGB unless the recipe says otherwise.",
            "method": "Read the output's color metadata."
          },
          {
            "id": "empty-frames",
            "threshold": "No fully transparent or single-color frame unless the recipe declares it.",
            "method": "Per-frame pixel statistics."
          },
          {
            "id": "repeatability",
            "threshold": "Two renders give identical digests for deterministic renderers, or SSIM of at least 0.99 for GPU renderers that are not bit-exact.",
            "method": "Render twice; compare digests or run ffmpeg's ssim filter."
          },
          {
            "id": "text-contrast",
            "threshold": "Text contrast at least 4.5:1, or 3:1 for text 24 px and larger, against what is behind it.",
            "method": "WCAG relative luminance, as in example.contrast."
          },
          {
            "id": "text-size",
            "threshold": "Overlay text at least 24 px tall at 1080p.",
            "method": "Font size from the recipe, scaled to the canvas."
          },
          {
            "id": "safe-area",
            "threshold": "Every element inside the inner 90 percent of the canvas.",
            "method": "Element bounds from the recipe and the render."
          },
          {
            "id": "missing-resources",
            "threshold": "The renderer log reports no missing texture, font or file.",
            "method": "Scan the render log."
          },
          {
            "id": "render-budget",
            "threshold": "Wall time within the brief's budget.",
            "method": "The render manifest's wall_seconds."
          },
          {
            "id": "asset-licenses",
            "threshold": "Every asset's license is allowed by the asset policy.",
            "method": "Deterministic join of elements and asset nouns."
          },
          {
            "id": "reduced-motion",
            "threshold": "Every motion profile names a reduced-motion alternative.",
            "method": "Read the motion profiles."
          }
        ],
        "rules": [
          "Every check reports its measurement.",
          "not_run and not_applicable always carry a reason; neither counts as pass.",
          "passed is true only if every check is pass or not_applicable."
        ],
        "contrast_example": {
          "$pin": "example.contrast"
        }
      },
      "relations": [
        [
          "requires_noun",
          "example.contrast"
        ]
      ]
    },
    {
      "slug": "example.contrast",
      "category": "noun.benchmark_suite",
      "role": "worked_example",
      "title": "MADE-UP worked example: text contrast ratios",
      "made-up": true,
      "category_reason": "A golden fixture with reference values that the validator recomputes.",
      "value": {
        "fixture_kind": "contrast_ratio",
        "formula": "Relative luminance L = 0.2126 R + 0.7152 G + 0.0722 B of linearized sRGB channels (c/12.92 at or below 0.04045, else ((c + 0.055) / 1.055) ^ 2.4); ratio = (L_lighter + 0.05) / (L_darker + 0.05).",
        "thresholds": {
          "normal_text": 4.5,
          "large_text": 3.0
        },
        "pairs": [
          {
            "id": "white-on-black",
            "foreground": "#ffffff",
            "background": "#000000"
          },
          {
            "id": "gray-767676-on-white",
            "foreground": "#767676",
            "background": "#ffffff"
          },
          {
            "id": "gray-777777-on-white",
            "foreground": "#777777",
            "background": "#ffffff"
          },
          {
            "id": "yellow-on-white",
            "foreground": "#ffff00",
            "background": "#ffffff"
          },
          {
            "id": "blue-on-white",
            "foreground": "#0000ff",
            "background": "#ffffff"
          }
        ],
        "expected": {
          "white-on-black": {
            "ratio": 21.0,
            "normal_text": true,
            "large_text": true
          },
          "gray-767676-on-white": {
            "ratio": 4.54,
            "normal_text": true,
            "large_text": true
          },
          "gray-777777-on-white": {
            "ratio": 4.48,
            "normal_text": false,
            "large_text": true
          },
          "yellow-on-white": {
            "ratio": 1.07,
            "normal_text": false,
            "large_text": false
          },
          "blue-on-white": {
            "ratio": 8.59,
            "normal_text": true,
            "large_text": true
          }
        },
        "reading": [
          "The expected ratios are the widely published reference values for these color pairs.",
          "#767676 is the lightest gray that passes 4.5:1 on white; #777777 just misses it."
        ]
      }
    },
