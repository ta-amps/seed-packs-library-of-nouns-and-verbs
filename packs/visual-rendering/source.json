                  "type": "string",
                  "enum": [
                    "srgb",
                    "linear",
                    "display_p3"
                  ]
                }
              }
            }
          }
        },
        "rules": [
          "Every element references an asset noun by pin.",
          "The seed makes procedural parts repeatable."
        ],
        "example": {
          "scene_id": "title-card",
          "kind": "motion",
          "canvas": {
            "width": 1920,
            "height": 1080,
            "fps": 30,
            "duration_s": 4,
            "background": "#101418"
          },
          "elements": [
            {
              "element_id": "title",
              "asset_ref": "MADE-UP font asset pin",
              "position": [
                960,
                540
              ],
              "scale": 1,
              "rotation_deg": [
                0
              ],
              "motion_ref": "MADE-UP fade-up motion pin",
              "text": "One request, one checked result",
              "font": "Inter",
              "z": 1
            }
          ],
          "palette": [
            "#101418",
            "#f4f6f8",
            "#3d8bfd"
          ],
          "renderer": "MADE-UP: an SVG frame renderer rasterized with a pinned browser build",
          "seed": 7,
          "output": {
            "format": "webm",
            "color_space": "srgb"
          }
        }
      },
      "category_reason": "A declarative scene layout and asset binding graph."
    },
