    {
      "slug": "template.scene-recipe",
      "category": "noun.scene_recipe",
      "role": "template",
      "title": "Template: a scene recipe: canvas, camera, lights, elements, palette, renderer, seed and output",
      "value": {
        "describes": "a scene recipe: canvas, camera, lights, elements, palette, renderer, seed and output",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_id",
            "kind",
            "canvas",
            "elements",
            "renderer",
            "output",
            "seed"
          ],
          "properties": {
            "scene_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "pattern": "^[a-z0-9-]+$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "image",
                "motion",
                "3d"
              ]
            },
            "canvas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 7680
                },
                "height": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 4320
                },
                "fps": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 120
                },
                "duration_s": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600
                },
                "background": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 40
                }
              }
            },
            "camera": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "position": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "target": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "fov_deg": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 179
                }
              }
            },
            "lights": {
              "type": "array",
              "minItems": 0,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "ambient",
                      "directional",
                      "point",
                      "area"
                    ]
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "color": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 9
                  }
                }
              }
            },
            "elements": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element_id",
                  "asset_ref"
                ],
                "properties": {
                  "element_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "asset_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "position": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "rotation_deg": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "motion_ref": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 300
                  },
                  "text": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 200
                  },
                  "font": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 80
                  },
                  "z": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            },
            "palette": {
              "type": "array",
              "minItems": 0,
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 9,
                "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
              }
            },
            "renderer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "seed": {
              "type": "integer",
              "minimum": 0
