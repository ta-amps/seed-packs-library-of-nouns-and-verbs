{
  "grid_id": "faiss-ivf-pq-and-ann-index-cascade-grid",
  "generation": 1,
  "expansion_factor": 2,
  "sha256_prefix_chars": 16,
  "float_axis_round_digits": 6,
  "parameters": [
    {
      "name": "nlist",
      "param_type": "integer_range",
      "low": 4,
      "high": 16,
      "step": 4,
      "default": 8
    },
    {
      "name": "nprobe",
      "param_type": "integer_range",
      "low": 1,
      "high": 8,
      "step": 1,
      "default": 4
    },
    {
      "name": "subspaces_m",
      "param_type": "choice",
      "choices": [4, 8],
      "default": 8
    },
    {
      "name": "subspace_centroids_k",
      "param_type": "choice",
      "choices": [8, 16, 32],
      "default": 16
    },
    {
      "name": "use_exact_rerank",
      "param_type": "boolean",
      "default": true
    },
    {
      "name": "rerank_top_r",
      "param_type": "integer_range",
      "low": 0,
      "high": 30,
      "step": 10,
      "default": 20
    },
    {
      "name": "search_regime",
      "param_type": "choice",
      "choices": ["fast_compact", "high_recall"],
      "default": "high_recall"
    }
  ],
  "constraints": [
    {
      "id": "disabled-rerank-requires-zero-top-r",
      "when": { "use_exact_rerank": false },
      "require_in": { "rerank_top_r": [0] }
    },
    {
      "id": "enabled-rerank-requires-positive-top-r",
      "when": { "use_exact_rerank": true },
      "require_in": { "rerank_top_r": [10, 20, 30] }
    }
  ],
  "regime_defaults": {
    "fast_compact": {
      "nlist": 8,
      "nprobe": 1,
      "subspaces_m": 4,
      "subspace_centroids_k": 8,
      "use_exact_rerank": false,
      "rerank_top_r": 0,
      "search_regime": "fast_compact"
    },
    "high_recall": {
      "nlist": 8,
      "nprobe": 4,
      "subspaces_m": 8,
      "subspace_centroids_k": 16,
      "use_exact_rerank": true,
      "rerank_top_r": 20,
      "search_regime": "high_recall"
    }
  },
  "numerics": {
    "epsilon": 1e-12,
    "round_digits": 6,
    "float64_bytes": 8,
    "float32_bytes": 4,
    "max_uint8_centroids": 256,
    "coarse_kmeans_iters": 12,
    "pq_kmeans_iters": 12,
    "default_seed": 17,
    "default_top_k": 5
  },
  "synthetic_corpus_defaults": {
    "num_vectors": 192,
    "dim": 32,
    "num_clusters": 8,
    "num_queries": 24,
    "center_scale": 5.0,
