{"store": "seedpack.evaluation-design", "key": "evaluation-design.v0.1.0.method", "expected_version": 0, "producer_surface": "surface:tessera", "visibility_scope": "surface_only", "allowed_surfaces": [], "target_cohorts": ["all"], "tags": ["category:noun.skill_pack", "pack:evaluation-design", "role:method", "content:authored", "spdx:MIT", "status:quarantined"], "value": {"category_id": "noun.skill_pack", "role": "method", "pack": "evaluation-design", "pack_version": "0.1.0", "title": "Evaluation method: arms, frozen sets, pass marks before runs, exact-match scoring", "category_reason": "A reusable evaluation method with guardrails, generalized from an evaluation plan used in this ecosystem.", "origin": "Generalizes an existing evaluation plan: re-run fixed arms against a frozen set, score by exact match, run each arm twice and commit pass marks first. The source is named in the descriptor's provenance_notes.", "steps": ["Write the question the evaluation answers in one sentence, and the decision it informs.", "Define arms: a baseline and each change, one change per arm where possible, with exact models, prompts, tools and settings.", "Freeze the case set before any arm runs: opaque case ids, a manifest of case and label digests, and the generator or source pinned.", "Commit pass marks before the first scored run. A person approves them; they never change afterwards.", "Run every arm twice on the full frozen set. Record cost and latency per case from actual usage.", "Score by exact match against known labels with deterministic code; a model judge may grade only explanations, with a person spot-checking its grades.", "Report every mark as met, missed or unknown. A missed mark is reported as missed with its diagnosis, never reworded into a pass."], "rules": ["Case ids must not encode labels; the drafting and answering workers never see labels.", "Errors and timeouts are scored as wrong answers unless the plan says to exclude them; exclusions are reported with counts.", "Cost per case is null when any case's cost is unknown; report the known subtotal and the count of unknown cases.", "Spread between the two runs of an arm above the plan's limit marks the arm unstable.", "Changing a pass mark, the set or the scorer after a run starts requires a new evaluation version; old results stay as they were."], "metrics_menu": {"accuracy_points": "Share of cases answered exactly right, in points.", "recall_points": "Share of positive cases answered with the positive label, in points.", "twin_fp_points": "Share of negative twin cases wrongly given the positive label, in points.", "net_points": "Recall minus twin false positives, in points.", "abstention_points": "Share of cases held for review instead of answered, when the plan allows abstaining.", "cost_per_case_usd": "Actual usage times dated price, divided by cases; null when any case cost is unknown.", "p95_latency_ms": "From recorded per-case timings."}, "status": "proposal", "admission": "not_admitted", "content_kind": "authored_guidance", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "reason": "Tessera requires these axes, so each is set to its lowest value and the tier is unverified. No quality is claimed. Replace them only with measured values and the evidence that produced them."}, "relations": []}},
