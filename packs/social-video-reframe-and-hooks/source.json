    {
      "slug": "cutdown-checks",
      "category": "noun.benchmark_suite",
      "role": "record_checks",
      "title": "Deterministic checks for social video cutdown plans",
      "value": {
        "fixture_kind": "finding_checks",
        "purpose": "Deterministic checks every short-form cutdown plan must pass before rendering.",
        "deterministic_checks": [
          {
            "id": "valid-aspect",
            "rule": {
              "rule": "enum",
              "path": "aspect",
              "values": [
                "9:16",
                "1:1",
                "4:5"
              ]
            },
            "why": "Target aspect ratio must be one of the supported social frame shapes."
          },
          {
            "id": "claims-preserved",
            "rule": {
              "rule": "enum",
              "path": "claim_preservation_passed",
              "values": [
                true
              ]
            },
            "why": "Cutdowns that drop a claim's required qualifiers or evidence beat cannot proceed."
          },
          {
            "id": "has-keyframes",
            "rule": {
              "rule": "each_has",
              "path": "keyframes",
              "fields": [
                "framing_mode",
                "crop_w",
                "crop_h"
              ],
              "min": 1
            },
            "why": "At least one explicit crop keyframe with dimensions and framing mode is required."
          },
          {
            "id": "no-dropped-qualifiers",
            "rule": {
              "rule": "pattern_absent",
              "path": "violations",
              "pattern": "dropped_qualifier"
            },
            "why": "Recorded qualifier-drop violations block cutdown readiness."
          }
        ],
        "golden_fixtures": [
          {
            "id": "good-9x16-cutdown",
            "label": "known_good",
            "finding": {
              "aspect": "9:16",
              "claim_preservation_passed": true,
              "keyframes": [
                {
                  "time_s": 0.0,
                  "crop_w": 608,
                  "crop_h": 1080,
                  "framing_mode": "pan_crop"
                }
              ],
              "violations": []
            }
          },
          {
            "id": "bad-dropped-qualifier",
            "label": "known_bad",
            "finding": {
              "aspect": "9:16",
              "claim_preservation_passed": false,
              "keyframes": [
                {
                  "time_s": 0.0,
                  "crop_w": 608,
                  "crop_h": 1080,
                  "framing_mode": "pan_crop"
                }
              ],
              "violations": [
                "dropped_qualifier:warm_cache"
              ]
            }
          },
          {
            "id": "bad-unsupported-aspect",
            "label": "known_bad",
            "finding": {
              "aspect": "21:9",
              "claim_preservation_passed": true,
              "keyframes": [
                {
                  "time_s": 0.0,
                  "crop_w": 608,
                  "crop_h": 1080,
                  "framing_mode": "pan_crop"
                }
              ],
              "violations": []
            }
          }
        ],
        "expected": {
          "good-9x16-cutdown": {
            "verdict": "pass",
            "failed_checks": []
          },
          "bad-dropped-qualifier": {
            "verdict": "fail",
            "failed_checks": [
              "claims-preserved",
              "no-dropped-qualifiers"
            ]
          },
          "bad-unsupported-aspect": {
            "verdict": "fail",
            "failed_checks": [
              "valid-aspect"
            ]
          }
        }
      }
    },
