{
  "pack_id": "social-video-reframe-and-hooks",
  "title": "Social video reframe and hooks",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for planning vertical 9:16 and square 1:1 video cutdowns from 16:9 demos with subject-safe crop trajectories, hook-beat scoring, caption-band reflow, and claim-preservation gates, backed by standard-library Python code.",
  "boundaries": [
    "Critical regions wider than the target crop window switch to pillarbox_inset rather than clipping silently.",
    "No cutdown is marked ready_for_render if a headline claim loses any required qualifier or its evidence timestamp.",
    "Workers plan trajectories and editorial cuts locally; this pack never uploads or publishes media."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for reframing 16:9 demos into hook-first, claim-preserving social cutdowns",
      "value": {
        "lets_workers": "Plan smooth 9:16, 1:1, and 4:5 crop trajectories from 16:9 subject keyframes, score opening hook beats, reflow captions into safe zones under reading-speed caps, and enforce claim-qualifier preservation.",
        "not_for": "Uploading videos to external social networks or inventing unmeasured product claims.",
        "flow": [
          {
            "verb": {
              "$verb": "social-video-reframe-and-hooks.plan-subject-crop-trajectory"
            },
            "when": "Compute stabilized crop keyframes and pillarbox fallbacks."
          },
          {
            "verb": {
              "$verb": "social-video-reframe-and-hooks.score-opening-hook-beats"
            },
            "when": "Rank concrete outcome beats and reject splash intros."
          },
          {
            "verb": {
              "$verb": "social-video-reframe-and-hooks.reflow-safe-zone-captions"
            },
            "when": "Wrap timed captions into safe vertical bands under 18 CPS."
          },
          {
            "verb": {
              "$verb": "social-video-reframe-and-hooks.audit-claim-preservation"
            },
            "when": "Check that retained claims keep qualifiers and evidence beats."
          },
          {
            "verb": {
              "$verb": "social-video-reframe-and-hooks.compile-cutdown-plan"
            },
            "when": "Assemble the checked cutdown plan for local rendering."
          }
        ],
        "guardrails": [
          {
            "$pin": "guardrail.no-silent-subject-clip"
          },
          {
            "$pin": "guardrail.preserve-claim-qualifiers"
          }
        ],
        "tool": {
          "$pin": "tool.social-reframe"
        }
      },
      "relations": [
        [
          "requires_noun",
          "method"
        ],
        [
          "requires_noun",
          "guardrail.no-silent-subject-clip"
        ],
        [
          "requires_noun",
          "guardrail.preserve-claim-qualifiers"
        ],
        [
          "requires_noun",
          "rules.reframe-and-hooks"
        ],
        [
          "requires_noun",
          "tool.social-reframe"
        ],
        [
          "requires_noun",
          "template.cutdown-plan"
        ]
      ]
    },
    {
      "slug": "method",
      "category": "noun.skill_pack",
      "role": "method",
      "title": "Method: subject-safe framing, concrete hook selection, and claim-faithful editing",
      "value": {
        "lifecycle": [
          "plan-subject-crop-trajectory stabilizes horizontal/vertical panning with deadbands and velocity limits.",
          "score-opening-hook-beats selects an opening beat <= 5s showing concrete motion or output rather than title cards.",
          "reflow-safe-zone-captions wraps lines <= 32 chars inside vertical safe zones and checks reading speed <= 18 CPS.",
          "audit-claim-preservation blocks edits that keep a metric while cutting its benchmark scope or caveat.",
          "compile-cutdown-plan emits one deterministic JSON cutdown plan."
        ]
      }
    },
    {
      "slug": "guardrail.no-silent-subject-clip",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: wide UI tables or code blocks switch to pillarbox inset instead of clipping",
      "value": {
        "rule": "Whenever a subject or critical region exceeds the target crop width, framing_mode switches to pillarbox_inset and records the clip violation explicitly.",
        "how_it_is_checked": "plan_crop_trajectory checks every critical region against [crop_x, crop_x + crop_w]."
      }
    },
    {
      "slug": "guardrail.preserve-claim-qualifiers",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: shortened cutdowns keep every qualifier and evidence timestamp of spoken claims",
      "value": {
        "rule": "If a cutdown caption states a headline metric, every required qualifier for that claim must remain present in the cutdown captions and its evidence timestamp must lie inside retained segments.",
        "how_it_is_checked": "check_claim_preservation verifies substring presence and segment timestamp containment."
      }
    },
    {
      "slug": "rules.reframe-and-hooks",
      "category": "noun.motion_profile",
      "role": "rules",
      "title": "Geometry, pan stabilization, hook scoring, and caption safe-band parameters",
      "value": {
        "crop_sizes_from_1920x1080": {
          "9:16": [
            608,
            1080
          ],
          "1:1": [
            1080,
            1080
          ],
          "4:5": [
            864,
            1080
          ]
        },
        "pan_deadband_px": 36.0,
        "max_pan_px_per_sec": 420.0,
        "safe_vertical_bands": {
          "9:16": [
            0.14,
            0.78
          ],
          "1:1": [
            0.1,
            0.86
          ],
          "4:5": [
            0.12,
            0.82
          ]
        },
        "caption_limits": {
          "max_lines": 2,
          "max_chars_per_line": 32,
          "max_chars_per_sec": 18.0
        }
      }
    },
