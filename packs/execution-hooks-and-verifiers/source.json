    {
      "slug": "guardrail.no-permission-bypass-or-secret-exposure",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: pre_tool hooks block permission-bypass flags, secret reads, destructive commands, contributor downgrades and unapproved spend",
      "category_reason": "Stops destructive shell calls, secret leaks and unbudgeted spend before any tool executes.",
      "value": {
        "rule": "Every compiled harness configuration sets disable_bypass_permissions true, and pre_tool evaluation denies --dangerously-skip-permissions, .env reads, printenv dumps, destructive rm -rf or force flags, contributor-mode downgrades and spend exceeding approved_spend_cap_usd.",
        "how_it_is_checked": "PortableHookCompiler.evaluate_pre_tool returns blocked true with decision deny or rewrite_hint."
      }
    },
    {
      "slug": "guardrail.distinct-principals-and-mutation-audited-verifiers",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: pre_submit gates enforce non-anonymous multi-principal attestation and Checks-of-Checks mutation sensitivity",
      "category_reason": "Prevents self-approved submissions and rubber-stamp or broken verifiers.",
      "value": {
        "rule": "Multi-principal checks require distinct non-anonymous drafter and reviewer worker_id and key_id values, and verifiers with clean-twin false positives or insufficient mutation kill rates never classify as trusted.",
        "how_it_is_checked": "ComposableVerifierDagAndMutationGate.execute_verifier_dag and audit_verifier_sensitivity enforce both invariants deterministically."
      }
    },
