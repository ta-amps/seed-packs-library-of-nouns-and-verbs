{
  "pack_id": "execution-hooks-and-verifiers",
  "title": "Execution hooks and verifiers",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for compiling four-stage portable execution hooks across coding harnesses, enforcing pre-tool safety and spend guards, running topological pre-submit verifier DAGs, auditing verifier mutation sensitivity and extracting dead-end negative tombstones.",
  "dependencies": [
    "configuration-grids-and-bounds",
    "checks-of-checks",
    "wiring-and-conformance-checks",
    "agent-capability-and-tier-firewall"
  ],
  "boundaries": [
    "Compiled harness configs enforce disable_bypass_permissions true and never weaken host sandboxes.",
    "Multi-principal publication checks refuse anonymous keys and require distinct drafter and reviewer principals.",
    "Verifiers that fail clean positive twins or miss synthetic mutations are classified reject or revise before gating work.",
    "Importing the pack writes nothing, enqueues nothing and installs no code."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for compiling four-stage portable execution hooks across coding harnesses, enforcing pre-tool safety and spend guards, running topological pre-submit verifier DAGs, auditing verifier mutation sensitivity and extracting dead-end negative tombstones",
      "value": {
        "lets_workers": "Compile declarative pre_claim, pre_tool, post_step and pre_submit hook specifications across claude_code, muse_code, opencode and pi_coding_agent, intercept unsafe commands, secret reads, CSP or browser-storage anti-patterns and unapproved spend before execution, run topological pre_submit verifier DAGs, audit checks via synthetic twin mutations and record normalized negative_tombstone signatures.",
        "flow": [
          {
            "verb": {
              "$verb": "execution-hooks-and-verifiers.compile-portable-hooks-and-guard-tools"
            },
            "when": "Compile 4-stage hook specs across four agent harnesses and evaluate pre_tool calls into allow, deny or rewrite_hint."
          },
          {
            "verb": {
              "$verb": "execution-hooks-and-verifiers.execute-verifier-dag-and-tombstones"
            },
            "when": "Run topological pre_submit verifier DAGs and extract normalized negative_tombstone signatures from failed runs."
          },
          {
            "verb": {
              "$verb": "execution-hooks-and-verifiers.audit-verifier-mutation-sensitivity"
            },
            "when": "Audit candidate verifiers on clean positive twins and mutated negatives to classify trusted, revise or reject."
          }
        ],
        "guardrails": [
          {
            "$pin": "guardrail.no-permission-bypass-or-secret-exposure"
          },
          {
            "$pin": "guardrail.distinct-principals-and-mutation-audited-verifiers"
          }
        ],
        "tool": {
          "$pin": "tool.hooks-verifiers"
        },
        "worked_example": "Synthetic 4-harness hook compilation, 5-call pre_tool guard, 5-node topological verifier DAG and 3-verifier mutation audit recomputed in test_hooks_verifiers.py: enforces disable_bypass_permissions across all four harnesses, blocks skip-permissions, .env reads and over-budget spend with deny, flags inline style={{ with rewrite_hint, blocks self-attested multi-principal checks while skipping downstream bootstrap nodes, classifies strong/weak/overstrict verifiers into trusted/revise/reject and emits deterministic tombstone:6a5252264615."
      },
