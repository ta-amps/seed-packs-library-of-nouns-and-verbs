  "verbs": [
    {
      "slug": "find-budget-document",
      "kind": "verb.probe_source",
      "title": "Find the official budget document and read its terms",
      "claimant": "agent",
      "summary": "Find the jurisdiction's official budget document for the fiscal year through its publisher's own site or download, and record its access method and terms.",
      "outcome": "The official budget document located, or blocked when its terms forbid automated reading.",
      "ready_outcome": "document_found",
      "pinned": [
        "policy-and-law-watch:guardrail.public-sources-only",
        "policy-and-law-watch:guardrail.no-scraping-against-terms"
      ],
      "params": {
        "jurisdiction": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "The state or city."
        },
        "fiscal_year": {
          "schema": {
            "type": "string",
            "pattern": "^FY[0-9]{4}$"
          },
          "description": "The fiscal year, such as FY2027.",
          "default": "FY2027"
        }
      },
      "network": [
        "read_only",
        "The jurisdiction's own official budget publications only, through their website or bulk download as their terms permit; no logins and no personal data."
      ],
      "produces": [
        {
          "name": "budget_source",
          "template": "template.budget-source"
        }
      ],
      "steps": [
        "Find the budget on the publisher's own official site.",
        "Read the terms first, and stop with blocked if they forbid automated reading.",
        "Record the access method and the date the terms were read."
      ],
      "acceptance": [
        {
          "id": "matches-template",
          "check": "The output validates against template.budget-source's schema.",
          "method": "deterministic"
        },
        {
          "id": "official-publisher",
          "check": "The source is published by the jurisdiction's own budget office or legislature.",
          "method": "deterministic"
        }
      ],
      "bounds": {
        "max_elapsed_seconds": 900
      }
    },
