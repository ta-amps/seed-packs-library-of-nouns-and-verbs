      "category": "noun.seed_hypothesis",
      "role": "template",
      "title": "Template: a program area's line items, each with its page and line",
      "category_reason": "Extracted line items are a structured reading of the budget that review confirms.",
      "value": {
        "describes": "the line items of one program area from an official budget document, each with its fund, fiscal year, amount, page and line",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_url",
            "program_area",
            "items"
          ],
          "properties": {
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "program_area": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "program_area",
                  "line_item",
                  "fund",
                  "fiscal_year",
                  "amount",
                  "page",
                  "line"
                ],
                "properties": {
                  "program_area": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "line_item": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "fund": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "fiscal_year": {
                    "type": "string",
                    "pattern": "^FY[0-9]{4}$"
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "rules": [
          "Every amount is copied from its page and line unchanged."
        ]
      }
    },
    {
      "slug": "template.budget-report",
      "category": "noun.seed_hypothesis",
      "role": "template",
      "title": "Template: a cited budget report for one program area",
      "category_reason": "A budget report is a candidate that a different worker reviews and a person decides on.",
      "value": {
        "describes": "a plain-language report on one program area's budget in which every figure cites its page and line, with changes computed from cited figures",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_url",
            "program_area",
            "notice",
            "figures",
            "changes",
            "points"
          ],
          "properties": {
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "program_area": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "notice": {
              "type": "string",
              "const": "Figures come from the official budget document cited. This report is not financial or legal advice."
            },
            "figures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "amount",
                  "page",
                  "line"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "changes": {
              "type": "array",
              "minItems": 0,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "from_amount",
                  "to_amount",
                  "change",
                  "percent_change"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "from_amount": {
                    "type": "number"
                  },
                  "to_amount": {
                    "type": "number"
                  },
                  "change": {
                    "type": "number"
                  },
                  "percent_change": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "points": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "cites"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  "cites": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                }
              }
            }
          }
        },
        "rules": [
          "Every figure cites a page and line.",
          "Every change is computed from two cited figures."
        ]
      }
    },
