{
  "pack_id": "public-budget-report",
  "title": "Public budget report",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for reporting on a public state or city budget: finding the official budget document through permitted access, extracting one program area's line items with their pages and lines, writing a report that cites every figure, having a different worker review it, and delivering it only when a person decides.",
  "dependencies": [
    "policy-and-law-watch"
  ],
  "boundaries": [
    "Official public budget documents only, through access their publishers permit; never scraping against a platform's terms.",
    "No personal data, and a page and line for every figure.",
    "A person decides what is delivered; outputs stay surface_only in the requester's scope.",
    "Importing the pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for reporting on a public state or city budget, one program area at a time",
      "value": {
        "lets_workers": "Find a jurisdiction's official budget document, extract the line items for one program area with their pages and lines, and write a plain report in which every figure is cited and every change is computed from cited figures. A different worker reviews every figure, and a person decides whether the report is delivered.",
        "flow": [
          {
            "verb": {
              "$verb": "public-budget-report.find-budget-document"
            }
          },
          {
            "verb": {
              "$verb": "public-budget-report.extract-line-items"
            }
          },
          {
            "verb": {
              "$verb": "public-budget-report.write-budget-report"
            }
          },
          {
            "verb": {
              "$verb": "public-budget-report.review-budget-report"
            }
          },
          {
            "verb": {
              "$verb": "public-budget-report.decide-delivery"
            }
          }
        ],
        "guardrails": [
          {
            "$pin": "policy-and-law-watch:guardrail.public-sources-only"
          },
          {
            "$pin": "policy-and-law-watch:guardrail.no-scraping-against-terms"
          },
          {
            "$pin": "policy-and-law-watch:guardrail.no-personal-data"
          },
          {
            "$pin": "policy-and-law-watch:guardrail.cite-every-claim"
          },
          {
            "$pin": "policy-and-law-watch:guardrail.person-decides"
          }
        ],
        "worked_examples": "Offline only: two pages of a made-up stand-in city budget, its Library Services line items and a cited report, each checked against its template."
      },
      "relations": [
        [
          "requires_noun",
          "policy-and-law-watch:guardrail.public-sources-only"
        ],
        [
          "requires_noun",
          "policy-and-law-watch:guardrail.no-scraping-against-terms"
        ],
        [
          "requires_noun",
          "policy-and-law-watch:guardrail.no-personal-data"
        ],
        [
          "requires_noun",
          "policy-and-law-watch:guardrail.cite-every-claim"
        ],
        [
          "requires_noun",
          "policy-and-law-watch:guardrail.person-decides"
        ],
        [
          "requires_noun",
          "template.budget-source"
        ],
        [
          "requires_noun",
          "template.line-items"
        ],
        [
          "requires_noun",
          "template.budget-report"
        ]
      ]
    },
    {
      "slug": "template.budget-source",
      "category": "noun.seed_hypothesis",
      "role": "template",
      "title": "Template: the official budget document found, and how it may be read",
      "category_reason": "A located budget document is a lead that extraction and review confirm.",
      "value": {
        "describes": "the official budget document for a jurisdiction and fiscal year, with its publisher, access method and terms",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jurisdiction",
            "fiscal_year",
            "publisher",
            "source_url",
            "access",
            "terms_permit_automated_reading",
            "terms_read_on"
          ],
          "properties": {
            "jurisdiction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "fiscal_year": {
              "type": "string",
              "pattern": "^FY[0-9]{4}$"
            },
            "publisher": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "access": {
              "type": "string",
              "enum": [
                "official website",
                "official feed",
                "official api",
                "official bulk download"
              ]
            },
            "terms_permit_automated_reading": {
              "type": "boolean",
              "const": true
            },
            "terms_read_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "example": {
          "jurisdiction": "City of Example (made-up)",
          "fiscal_year": "FY2027",
          "publisher": "City of Example Budget Office (made-up)",
          "source_url": "https://example.invalid/budget/fy2027-adopted.pdf",
          "access": "official bulk download",
          "terms_permit_automated_reading": true,
          "terms_read_on": "2026-10-30"
        }
      }
    },
    {
