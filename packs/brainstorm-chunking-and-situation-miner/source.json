              "maxLength": 300
            },
            "constraint": {
              "type": "string",
              "minLength": 5,
              "maxLength": 300
            }
          }
        }
      }
    },
    {
      "slug": "template.category-gap-report",
      "category": "noun.eval_run",
      "role": "template",
      "title": "Template: ranked seed-pack category gap report",
      "value": {
        "describes": "ranked category demand and coverage gap scores backed by content-addressed chunks",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_sha256",
            "compression_ratio",
            "ranked_category_gaps"
          ],
          "properties": {
            "raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "compression_ratio": {
              "type": "string",
              "minLength": 3,
              "maxLength": 32
            },
            "ranked_category_gaps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "category_id",
                  "demand_score",
                  "existing_pack_count",
                  "gap_score"
                ],
                "properties": {
                  "category_id": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 80
                  },
                  "demand_score": {
                    "type": "number",
                    "minimum": 0
                  },
                  "existing_pack_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gap_score": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "slug": "mining-checks",
      "category": "noun.benchmark_suite",
      "role": "record_checks",
      "title": "Deterministic checks for brainstorm chunking and category gap reports",
      "value": {
        "fixture_kind": "finding_checks",
        "purpose": "Deterministic checks every brainstorm chunking and situation mining report must pass.",
        "deterministic_checks": [
          {
            "id": "raw-digest-pinned",
            "rule": {
              "rule": "pattern_present",
              "path": "raw_sha256",
              "pattern": "^[0-9a-f]{64}$"
            },
            "why": "Every mining report pins the SHA-256 digest of the raw input notes."
          },
          {
            "id": "chunks-have-hashes",
            "rule": {
              "rule": "each_has",
              "path": "chunks",
              "fields": [
                "chunk_id",
                "title",
                "text_sha256"
              ],
              "min": 1
            },
            "why": "Every emitted chunk carries a stable identifier, title, and SHA-256 digest."
          },
          {
            "id": "gaps-have-scores",
            "rule": {
              "rule": "each_has",
              "path": "ranked_category_gaps",
              "fields": [
                "category_id",
                "gap_score"
              ],
              "min": 1
            },
            "why": "Candidate categories must carry explicit numeric gap scores."
          },
          {
            "id": "hosts-local",
            "rule": {
              "rule": "hosts_local_only",
              "path": "$"
            },
            "why": "Local mining fixtures must not embed external network endpoints."
          }
        ],
        "golden_fixtures": [
          {
            "id": "good-mined-report",
