    {
      "slug": "tool.brainstorm-miner",
      "category": "noun.code_node",
      "role": "tool_card",
      "title": "Tool card: brainstorm_miner standard-library CLI and library",
      "value": {
        "name": "brainstorm_miner",
        "code": {
          "$code": "brainstorm-chunking-and-situation-miner"
        },
        "runtime": "Python 3.10 or later, standard library only.",
        "commands": [
          "python3 -m brainstorm_miner dedup RAW_NOTES.txt",
          "python3 -m brainstorm_miner chunk RAW_NOTES.txt",
          "python3 -m brainstorm_miner mine RAW_NOTES.txt [--near-dup-threshold 0.85]"
        ],
        "does": [
          "Splits inline concatenated multi-pastes and collapses exact and 5-word shingle near-duplicates.",
          "Emits SHA-256-addressed chunks, real-world situations, and ranked category gap scores."
        ],
        "does_not": [
          "Make network requests, invoke external models, or overwrite the input notes file."
        ],
        "code_license": "MIT"
      },
      "relations": [
        [
          "verifies",
          "rules.shingle-dedup-and-gap-math"
        ]
      ]
