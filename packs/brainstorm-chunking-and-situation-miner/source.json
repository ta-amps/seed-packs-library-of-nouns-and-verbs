{
  "pack_id": "brainstorm-chunking-and-situation-miner",
  "title": "Brainstorm chunking and situation miner",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for deduplicating noisy raw notes, chunking unstructured text into content-addressed records, and clustering real-world situations into candidate seed-pack categories, with tested standard-library Python code.",
  "boundaries": [
    "Inline or block clipboard repeats are collapsed losslessy while unique epilogues and preambles stay intact.",
    "Every emitted chunk is pinned by a deterministic UTF-8 SHA-256 digest and raw block occurrence count.",
    "Mined situations and category gap rankings remain backlog proposals until human review.",
    "Workers create nouns and propose verbs; importing this pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for deduplicating noisy raw notes and mining seed-pack situations",
      "value": {
        "lets_workers": "Collapse accidental multi-paste repeats in raw notes, split canonical text into SHA-256-addressed chunks, extract actor-problem-constraint situations, and rank candidate seed-pack categories by unmet demand.",
        "not_for": "Deleting original user notes or admitting new seed packs without human review.",
        "flow": [
          {
            "verb": {
              "$verb": "brainstorm-chunking-and-situation-miner.deduplicate-raw-notes"
            },
            "when": "First: split inline or block repeats and collapse duplicates."
          },
          {
            "verb": {
              "$verb": "brainstorm-chunking-and-situation-miner.chunk-canonical-notes"
            },
            "when": "Segment deduplicated blocks into content-addressed chunks."
          },
          {
            "verb": {
              "$verb": "brainstorm-chunking-and-situation-miner.extract-real-world-situations"
            },
            "when": "Distill chunks into concrete actor-problem-constraint situations."
          },
          {
            "verb": {
              "$verb": "brainstorm-chunking-and-situation-miner.score-category-coverage-gaps"
            },
            "when": "Rank candidate categories against existing pack counts."
          }
        ],
        "guardrails": [
          {
            "$pin": "guardrail.preserve-unique-passages"
          },
          {
            "$pin": "guardrail.content-addressed-chunks"
          }
        ],
        "tool": {
          "$pin": "tool.brainstorm-miner"
        }
      },
      "relations": [
        [
          "requires_noun",
          "method"
        ],
        [
          "requires_noun",
          "guardrail.preserve-unique-passages"
        ],
        [
          "requires_noun",
          "guardrail.content-addressed-chunks"
        ],
        [
          "requires_noun",
          "rules.shingle-dedup-and-gap-math"
        ],
        [
          "requires_noun",
          "tool.brainstorm-miner"
        ],
        [
          "requires_noun",
          "template.category-gap-report"
        ]
      ]
    },
    {
      "slug": "method",
      "category": "noun.skill_pack",
      "role": "method",
      "title": "Method: split tandem repeats first, hash canonical chunks, then score category gaps",
      "category_reason": "Shared four-step procedure governing raw-note intake and situation clustering.",
      "value": {
        "lifecycle": [
          "deduplicate-raw-notes locates left-maximal 6-word repeat anchors to split inline pastes before Jaccard collapse.",
          "chunk-canonical-notes splits unique blocks on headings and weighted rubric lines with SHA-256 digests.",
          "extract-real-world-situations binds each chunk to an operational actor, problem, and constraint.",
          "score-category-coverage-gaps computes demand_score / (1 + existing_pack_count) and runs mining-checks."
        ]
      }
    },
    {
      "slug": "guardrail.preserve-unique-passages",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: never drop unique trailing or interleaved passages during paste collapse",
      "value": {
        "rule": "Tandem paste splitting cuts at both repeat starts and the end of the final matched span so trailing unique notes remain separate blocks.",
        "how_it_is_checked": "split_repeated_pastes adds p + match_len cuts and unit tests verify unique epilogue retention."
      }
    },
    {
      "slug": "guardrail.content-addressed-chunks",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: every mined situation cites a SHA-256-addressed chunk",
      "value": {
        "rule": "No situation or category gap score is emitted without source_chunk_id and 64-hex source_chunk_sha256.",
        "how_it_is_checked": "mining-checks enforces 64-hex SHA-256 digests on raw notes and chunks."
      }
    },
    {
      "slug": "rules.shingle-dedup-and-gap-math",
      "category": "noun.reflex_procedure",
      "role": "rules",
      "title": "Deterministic rules for inline paste splitting, 5-word shingle Jaccard, and gap scoring",
      "value": {
        "inline_paste_split": "6-word lowercase anchor tuples with left-maximal extension >= 16 words mark paste boundaries even without blank lines.",
        "near_duplicate_rule": "Blocks with normalized 5-word shingle Jaccard >= 0.85 collapse into the earliest canonical block.",
        "gap_score_formula": "gap_score = round(demand_score / (1 + existing_pack_count), 4)."
      }
    },
    {
      "slug": "template.dedup-summary",
      "category": "noun.eval_run",
      "role": "template",
      "title": "Template: raw-note paste deduplication summary",
      "value": {
        "describes": "block counts, compression ratio, and canonical digests after paste collapse",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_sha256",
            "raw_block_count",
            "unique_block_count",
            "compression_ratio"
          ],
          "properties": {
            "raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "raw_block_count": {
              "type": "integer",
              "minimum": 1
            },
            "unique_block_count": {
              "type": "integer",
              "minimum": 1
            },
            "compression_ratio": {
              "type": "string",
              "minLength": 3,
              "maxLength": 32
            }
          }
        }
      }
    },
    {
      "slug": "template.content-chunk",
      "category": "noun.public_source",
      "role": "template",
      "title": "Template: content-addressed semantic note chunk",
      "value": {
        "describes": "one deduplicated section chunk with SHA-256 digest and token estimate",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chunk_id",
            "title",
            "text_sha256",
            "byte_length",
            "token_estimate"
          ],
          "properties": {
            "chunk_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "text_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1
            },
            "token_estimate": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "slug": "template.situation-record",
