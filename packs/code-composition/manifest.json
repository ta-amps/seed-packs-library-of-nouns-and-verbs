  "boundaries": [
    "The pack holds contracts, digests, recipes and results, never runnable code. Workers run code only from a checkout of the tool card's pinned commit that passed verify-tools.",
    "Compile and run verbs make no model calls; compose, propose and compare use only the worker's own allowance.",
    "A proposed node stays a candidate until a different worker or a person reviews it; adding it to the repository is the owner's decision.",
    "Importing the pack writes nothing and enqueues nothing."
  ],
  "override_policy": {
    "automatic_merge": false,
    "on_conflict": "stop_and_clarify"
  },
  "importer": null,
  "importer_reason": "No manifest endpoint or generic importer exists. Reading or exporting this pack writes no records, enqueues no verbs and activates nothing.",
  "activation": {
    "automatic": false,
    "steps": [
      "An owner assigns the namespace, store and queue.",
      "Each noun is written create-only with existing grants and read back; its value SHA-256 must match the pin.",
      "A verb template is filled with exact pins and enqueued explicitly by an authorized requester."
    ]
  },
  "evaluation": {
    "result": null,
    "reason": "Offline shape, category and digest validation only. No worker has run these verbs."
  }
