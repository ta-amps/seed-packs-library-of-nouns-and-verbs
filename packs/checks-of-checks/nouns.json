-arxiv"], "targets": ["https-only"]}, {"id": "unknown-access", "operator": {"op": "set", "path": "access_method", "value": "scrape"}, "applies_to": ["good-releases"], "targets": ["access-method-known"]}, {"id": "undated", "operator": {"op": "clear", "path": "observed_at"}, "applies_to": ["good-arxiv"], "targets": ["observed-dated"]}, {"id": "claim-verified", "operator": {"op": "set", "path": "endpoint_status", "value": "verified"}, "applies_to": ["good-releases"], "targets": ["verified-has-evidence"]}, {"id": "add-signup", "operator": {"op": "append_text", "path": "next_step", "text": " Sign up for the newsletter first."}, "applies_to": ["good-arxiv"], "targets": ["no-signup"]}, {"id": "empty-topic", "operator": {"op": "set", "path": "topics", "value": [""]}, "applies_to": ["good-arxiv"], "targets": ["topics-listed"]}], "expected": {"summary": {"https-only": {"passes_good": 2, "kills": 1}, "publisher-named": {"passes_good": 2, "kills": 2}, "access-method-known": {"passes_good": 2, "kills": 1}, "observed-dated": {"passes_good": 2, "kills": 1}, "verified-has-evidence": {"passes_good": 2, "kills": 2}, "no-signup": {"passes_good": 2, "kills": 2}, "topics-listed": {"passes_good": 2, "kills": 0}, "github-only": {"passes_good": 0, "kills": 9}}, "caught": {"add-signup@good-arxiv": true, "bad-copied-claim": true, "claim-verified@good-releases": true, "drop-publisher@good-arxiv": true, "drop-publisher@good-releases": true, "empty-topic@good-arxiv": false, "plain-http@good-arxiv": true, "undated@good-arxiv": true, "unknown-access@good-releases": true}, "targeted_missed": ["empty-topic@good-arxiv:topics-listed"], "verdicts": {"https-only": "trusted", "publisher-named": "trusted", "access-method-known": "trusted", "observed-dated": "trusted", "verified-has-evidence": "trusted", "no-signup": "trusted", "topics-listed": "revise", "github-only": "reject"}}, "reading": ["github-only is rejected because it fails the known-good arXiv card, so its catches count for nothing.", "topics-listed is sent back for revision: it misses the empty-topic mutation aimed at it, which no trustworthy check catches."], "status": "proposal", "admission": "not_admitted", "content_kind": "made_up_example", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "reason": "Tessera requires these axes, so each is set to its lowest value and the tier is unverified. No quality is claimed. Replace them only with measured values and the evidence that produced them."}, "relations": [{"relation": "requires_noun", "target_id": "seedpack.checks-of-checks/checks-of-checks.v0.1.0.rule-types", "target_category": "noun.reflex_procedure", "note": ""}, {"relation": "requires_noun", "target_id": "seedpack.checks-of-checks/checks-of-checks.v0.1.0.mutation-operators", "target_category": "noun.reflex_procedure", "note": ""}, {"relation": "requires_noun", "target_id": "seedpack.checks-of-checks/checks-of-checks.v0.1.0.method", "target_category": "noun.skill_pack", "note": ""}]}},
