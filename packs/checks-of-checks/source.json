{
  "pack_id": "checks-of-checks",
  "title": "Checks of checks",
  "version": "0.1.0",
  "summary": "Generate tests or rubric items for a verb's output and validate each one against known-good and known-bad examples, including mutations, before trusting it; with a worked example the validator recomputes.",
  "dependencies": [
    "tool-discovery"
  ],
  "boundaries": [
    "A check is trusted only after it passes every known-good example and catches known-bad ones.",
    "The author of a check does not build its only example set or review it.",
    "Importing the pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "Checks of checks seed pack",
      "value": {
        "lets_workers": "Write tests or rubric items for any verb's output, then prove each check works before anyone trusts it: it must pass known-good examples and catch known-bad ones, including deliberate mutations.",
        "flow": [
          {
            "verb": {
              "$verb": "checks-of-checks.draft-checks"
            },
            "when": "For a verb output whose shape is defined by a template noun."
          },
          {
            "verb": {
              "$verb": "checks-of-checks.build-example-set"
            },
            "when": "Collect known-good outputs and known-bad ones, and add mutations."
          },
          {
            "verb": {
              "$verb": "checks-of-checks.validate-checks"
            },
            "when": "Run every check against every example; deterministic."
          },
          {
            "verb": {
              "$verb": "checks-of-checks.review-checks"
            },
            "when": "A different worker decides which checks to trust."
          }
        ],
        "trust_rule": {
          "$pin": "method"
        },
        "worked_example": {
          "$pin": "example.source-card-checks"
        }
      },
      "relations": [
        [
          "requires_noun",
          "method"
        ],
        [
          "requires_noun",
          "rule-types"
        ],
        [
          "requires_noun",
          "mutation-operators"
        ],
        [
          "requires_noun",
          "example.source-card-checks"
        ],
        [
          "requires_noun",
          "template.check-suite"
        ],
        [
          "requires_noun",
          "template.example-set"
        ],
        [
          "requires_noun",
          "template.check-validation"
        ]
      ]
    },
    {
      "slug": "method",
      "category": "noun.skill_pack",
      "role": "method",
      "title": "When a check can be trusted",
      "category_reason": "A reusable verification method with its guardrails.",
      "value": {
        "trust_rule": [
          "A check passes every known-good example. One failure on a known-good example means reject.",
          "A check catches at least one known-bad example or targeted mutation. Catching nothing means revise: it is untested, not proven.",
          "Every mutation that targets a check is caught by that check; a missed target is reported.",
          "A deterministic check gives the same result on a repeat run.",
          "A judgment check needs two independent judges, or a person, agreeing on the examples before it is trusted."
        ],
        "known_good_sources": [
          "Accepted outputs with receipts",
          "Authored examples reviewed by a person",
          "Synthetic examples marked synthetic"
        ],
        "known_bad_sources": [
          "Real failures from execution history, sanitized",
          "Targeted mutations of known-good examples",
          "Authored counterexamples"
        ],
        "cautions": [
          "The worker that wrote a check does not build its only example set.",
          "Never edit a known-good example to make a check pass.",
          "Keep examples private when they came from private outputs."
        ]
      }
    },
    {
      "slug": "rule-types",
      "category": "noun.reflex_procedure",
      "role": "rule_language",
      "title": "Deterministic check rules",
      "category_reason": "A zero-call deterministic rule language: the same document always gives the same result.",
      "value": {
        "paths": "Dotted field names from the document root; $ is the whole document.",
        "rules": {
          "present": "The value at path exists and is not empty.",
          "enum": "The value at path is one of values.",
          "min_items": "The value at path is a list with at least min items.",
          "each_has": "Every item of the list at path has non-empty fields; min sets a minimum length.",
          "pattern_absent": "No string anywhere under path matches pattern.",
          "pattern_present": "Some string under path matches pattern.",
          "when": "If the condition holds (equals or in), the nested rule must pass; otherwise the rule passes."
        },
        "model_calls": 0
      }
    },
    {
      "slug": "mutation-operators",
      "category": "noun.reflex_procedure",
      "role": "mutation_operators",
      "title": "Mutation operators for building known-bad examples",
      "category_reason": "Zero-call deterministic transformations of known-good examples.",
      "value": {
        "operators": {
          "delete": "Remove the field at path.",
          "clear": "Replace the value at path with an empty list, object or string.",
          "set": "Replace the value at path with value.",
          "append_text": "Append text to the string at path.",
          "delete_item_field": "Remove field from every item of the list at path."
        },
        "model_calls": 0,
        "guidance": [
          "Aim each mutation at one check and name it in targets.",
          "Prefer mutations that mirror real failures: missing fields, wrong types, copied claims, forbidden steps."
        ]
      }
    },
    {
      "slug": "example.source-card-checks",
      "category": "noun.benchmark_suite",
      "role": "worked_example",
      "title": "SYNTHETIC worked example: checks for tool-discovery source cards",
      "synthetic": true,
      "category_reason": "A golden fixture: checks, known-good and known-bad examples, mutations and recorded expected results.",
      "value": {
        "fixture_kind": "check_validation",
        "purpose": "Shows the trust rule catching a wrong check (github-only fails a good card) and a too-weak check (topics-listed misses the mutation aimed at it). The validator recomputes it.",
        "target_template_ref": {
          "$pin": "tool-discovery:template.source-card"
        },
        "check_suite": [
          {
            "id": "https-only",
            "rule": {
              "rule": "pattern_present",
              "path": "url",
              "pattern": "^https://"
            },
            "why": "Sources are read over HTTPS only."
          },
          {
            "id": "publisher-named",
            "rule": {
              "rule": "present",
              "path": "publisher"
            },
            "why": "Every source names who publishes it."
          },
          {
            "id": "access-method-known",
            "rule": {
              "rule": "enum",
              "path": "access_method",
              "values": [
                "rss",
                "atom",
                "api",
                "html",
                "newsletter"
              ]
            },
            "why": "The collector depends on the access method."
          },
          {
            "id": "observed-dated",
            "rule": {
              "rule": "present",
              "path": "observed_at"
            },
            "why": "Every observation is dated."
          },
          {
            "id": "verified-has-evidence",
            "rule": {
              "rule": "when",
              "if": {
                "path": "endpoint_status",
                "equals": "verified"
              },
              "then": {
                "rule": "present",
                "path": "verification_evidence"
              }
            },
            "why": "A verified endpoint shows how it was verified."
          },
          {
            "id": "no-signup",
            "rule": {
              "rule": "pattern_absent",
              "path": "next_step",
              "pattern": "(?i)\\b(sign up|subscribe|create an account|log in|buy)\\b"
            },
            "why": "Discovery never signs up, subscribes, logs in or buys."
          },
          {
            "id": "topics-listed",
            "rule": {
              "rule": "min_items",
              "path": "topics",
              "min": 1
            },
            "why": "Every source serves at least one topic."
          },
          {
            "id": "github-only",
            "rule": {
              "rule": "pattern_present",
              "path": "url",
              "pattern": "^https://github\\.com/"
            },
            "why": "A deliberately wrong check: it rejects a known-good arXiv card, so validation must reject it."
          }
        ],
        "known_good": [
          {
            "id": "good-arxiv",
            "example": {
              "publisher": "arXiv cs.GR (Graphics)",
              "url": "https://rss.arxiv.org/rss/cs.GR",
              "access_method": "rss",
              "topics": [
                "3d"
              ],
              "endpoint_status": "verified",
              "verification_evidence": "SYNTHETIC: HTTP 200 with an RSS content type on the first probe",
              "observed_at": "2026-10-29",
              "next_step": "Scan daily on weekdays."
            }
          },
          {
            "id": "good-releases",
            "example": {
              "publisher": "SYNTHETIC tool releases",
              "url": "https://example.invalid/synthetic/tool/releases.atom",
              "access_method": "atom",
              "topics": [
                "motion-graphics"
              ],
              "endpoint_status": "untested_suggestion",
              "verification_evidence": "",
              "observed_at": "2026-10-29",
              "next_step": "Probe once before the first scan."
            }
          }
        ],
        "known_bad": [
          {
            "id": "bad-copied-claim",
            "example": {
              "publisher": "SYNTHETIC tool releases",
              "url": "https://example.invalid/synthetic/tool/releases.atom",
              "access_method": "atom",
              "topics": [
                "motion-graphics"
              ],
              "endpoint_status": "verified",
              "verification_evidence": "",
              "observed_at": "2026-10-29",
              "next_step": "Log in to the dashboard to see private releases."
            },
            "why": "A real-looking failure: a suggestion copied as verified, with a login step."
          }
        ],
        "mutations": [
          {
            "id": "drop-publisher",
            "operator": {
              "op": "delete",
              "path": "publisher"
            },
            "applies_to": [
              "good-arxiv",
              "good-releases"
            ],
            "targets": [
              "publisher-named"
            ]
          },
          {
            "id": "plain-http",
            "operator": {
              "op": "set",
              "path": "url",
              "value": "http://rss.arxiv.org/rss/cs.GR"
            },
            "applies_to": [
              "good-arxiv"
            ],
            "targets": [
              "https-only"
            ]
          },
          {
            "id": "unknown-access",
            "operator": {
              "op": "set",
              "path": "access_method",
              "value": "scrape"
            },
            "applies_to": [
              "good-releases"
            ],
            "targets": [
              "access-method-known"
            ]
          },
          {
            "id": "undated",
            "operator": {
              "op": "clear",
              "path": "observed_at"
            },
            "applies_to": [
              "good-arxiv"
            ],
            "targets": [
              "observed-dated"
            ]
          },
          {
            "id": "claim-verified",
            "operator": {
              "op": "set",
              "path": "endpoint_status",
              "value": "verified"
            },
            "applies_to": [
              "good-releases"
            ],
            "targets": [
              "verified-has-evidence"
            ]
          },
          {
            "id": "add-signup",
            "operator": {
              "op": "append_text",
              "path": "next_step",
              "text": " Sign up for the newsletter first."
            },
            "applies_to": [
              "good-arxiv"
            ],
            "targets": [
              "no-signup"
            ]
          },
          {
            "id": "empty-topic",
            "operator": {
              "op": "set",
              "path": "topics",
              "value": [
                ""
              ]
            },
            "applies_to": [
              "good-arxiv"
            ],
            "targets": [
              "topics-listed"
            ]
          }
        ],
        "expected": {
          "summary": {
            "https-only": {
              "passes_good": 2,
              "kills": 1
            },
            "publisher-named": {
              "passes_good": 2,
              "kills": 2
            },
            "access-method-known": {
              "passes_good": 2,
              "kills": 1
            },
            "observed-dated": {
              "passes_good": 2,
              "kills": 1
            },
            "verified-has-evidence": {
              "passes_good": 2,
              "kills": 2
            },
            "no-signup": {
              "passes_good": 2,
              "kills": 2
            },
            "topics-listed": {
              "passes_good": 2,
              "kills": 0
            },
            "github-only": {
              "passes_good": 0,
              "kills": 9
            }
          },
          "caught": {
            "add-signup@good-arxiv": true,
            "bad-copied-claim": true,
            "claim-verified@good-releases": true,
            "drop-publisher@good-arxiv": true,
            "drop-publisher@good-releases": true,
            "empty-topic@good-arxiv": false,
            "plain-http@good-arxiv": true,
            "undated@good-arxiv": true,
            "unknown-access@good-releases": true
          },
          "targeted_missed": [
            "empty-topic@good-arxiv:topics-listed"
          ],
          "verdicts": {
            "https-only": "trusted",
            "publisher-named": "trusted",
            "access-method-known": "trusted",
            "observed-dated": "trusted",
            "verified-has-evidence": "trusted",
            "no-signup": "trusted",
            "topics-listed": "revise",
            "github-only": "reject"
          }
        },
        "reading": [
          "github-only is rejected because it fails the known-good arXiv card, so its catches count for nothing.",
          "topics-listed is sent back for revision: it misses the empty-topic mutation aimed at it, which no trustworthy check catches."
        ]
      },
      "relations": [
        [
          "requires_noun",
          "rule-types"
        ],
        [
          "requires_noun",
          "mutation-operators"
        ],
        [
          "requires_noun",
          "method"
        ]
      ]
    },
