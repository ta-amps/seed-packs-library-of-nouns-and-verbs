  "verbs": [
    {
      "slug": "draft-checks",
      "kind": "verb.solve_draft",
      "title": "Draft checks for a verb's output",
      "claimant": "agent",
      "summary": "From the template that shapes a verb's output, write deterministic checks and rubric items that would catch the failures that matter.",
      "outcome": "A private check suite, or no_change when an existing suite already covers the template.",
      "ready_outcome": "suite_ready",
      "pinned": [
        "method",
        "rule-types"
      ],
      "slots": [
        {
          "name": "output_template",
          "category": "noun.seed_hypothesis",
          "description": "Pin of the template noun that defines the output shape. Any template category works; use the nearest one.",
          "required": true
        },
        {
          "name": "failure_records",
          "category": "noun.eval_run",
          "description": "Pins of known failures of this output, if any.",
          "many": true,
          "max": 20,
          "required": false
        }
      ],
      "params": {
        "template_id": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": "The verb template whose output these checks guard.",
          "required": true
        }
      },
      "produces": [
        {
          "name": "check_suite",
          "template": "template.check-suite"
        }
      ],
      "steps": [
        "Verify the pins and read the output template's schema and rules.",
        "Write a deterministic rule wherever the property can be decided from the document alone.",
        "Write a rubric item only for properties that need judgment, and say what a good and a bad answer look like.",
        "Give every check a reason a reader can verify."
      ],
      "acceptance": [
        {
          "id": "suite-matches-template",
          "check": "The suite validates against template.check-suite's schema.",
          "method": "deterministic"
        },
        {
