          {
            "clause": "Sec. 2",
            "text": "Distribution site means a fixed location where food is given out at no cost."
          },
          {
            "clause": "Sec. 3(a)",
            "text": "A nonprofit organization that gives out food to more than 100 households in a week shall register each distribution site with the city."
