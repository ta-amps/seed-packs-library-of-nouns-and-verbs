              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "publisher",
                  "source_url"
                ],
                "properties": {
                  "publisher": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "source_url": {
                    "type": "string",
                    "pattern": "^https://"
                  }
                }
              }
            }
          }
