{
  "pack_id": "policy-and-law-watch",
  "title": "Policy and law watch",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for watching official public sources for new laws and rules on a topic: reading them only through permitted official access, extracting their clauses, writing a summary that cites a clause for every point and is marked not legal advice, having a different worker review every citation, and delivering it only when a person decides.",
  "dependencies": [],
  "boundaries": [
    "Public sources only, through official access each source permits; never scraping against a platform's terms.",
    "No personal data, and a citation for every claim.",
    "A person decides what is delivered; outputs stay surface_only in the requester's scope.",
    "Importing the pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for watching official public sources for new laws and rules on a topic",
      "value": {
        "lets_workers": "Check official public sources for new laws and rules on a topic, extract each new text's clauses, and write a plain-language summary that cites a clause for every point and is marked not legal advice. A different worker reviews every citation, and a person decides whether the summary is delivered.",
        "flow": [
          {
            "verb": {
              "$verb": "policy-and-law-watch.check-sources"
            }
          },
          {
            "verb": {
              "$verb": "policy-and-law-watch.extract-clauses"
            }
          },
          {
            "verb": {
              "$verb": "policy-and-law-watch.write-cited-summary"
            }
          },
          {
            "verb": {
              "$verb": "policy-and-law-watch.review-citations"
            }
          },
          {
            "verb": {
              "$verb": "policy-and-law-watch.decide-delivery"
            }
          }
        ],
        "guardrails": [
          {
            "$pin": "guardrail.public-sources-only"
          },
          {
            "$pin": "guardrail.no-scraping-against-terms"
          },
          {
            "$pin": "guardrail.no-personal-data"
          },
          {
            "$pin": "guardrail.cite-every-claim"
          },
          {
            "$pin": "guardrail.person-decides"
          }
        ],
        "worked_examples": "Offline only: a made-up stand-in ordinance, its clause extract and a cited summary, each checked against its template."
      },
      "relations": [
        [
          "requires_noun",
          "guardrail.public-sources-only"
        ],
        [
          "requires_noun",
          "guardrail.no-scraping-against-terms"
        ],
        [
          "requires_noun",
          "guardrail.no-personal-data"
        ],
        [
          "requires_noun",
          "guardrail.cite-every-claim"
        ],
        [
          "requires_noun",
          "guardrail.person-decides"
        ],
        [
          "requires_noun",
          "template.rule-candidates"
        ],
        [
          "requires_noun",
          "template.clause-extract"
        ],
        [
          "requires_noun",
          "template.cited-summary"
        ],
        [
          "requires_noun",
          "template.citation-review"
        ],
        [
          "requires_noun",
          "template.delivery-record"
        ]
      ]
    },
    {
      "slug": "guardrail.public-sources-only",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: public sources only, through official and permitted access",
      "category_reason": "A guardrail is a reusable rule every verb in this work follows, with the check that proves it.",
      "value": {
        "rule": "Use only public sources, read through the access each source offers and permits: its own website, official feed, API or bulk download.",
        "how_it_is_checked": "Every source in a source check names its publisher, its access method and the date its terms were read."
      }
    },
    {
      "slug": "guardrail.no-scraping-against-terms",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: no scraping a platform against its terms",
      "category_reason": "A guardrail is a reusable rule every verb in this work follows, with the check that proves it.",
      "value": {
        "rule": "Never scrape a site or platform against its terms. Read each source's terms before use, and stop with the outcome blocked when the terms forbid automated reading.",
        "how_it_is_checked": "Every source in a source check records terms_permit_automated_reading true, or the run ends blocked."
      }
    },
    {
      "slug": "guardrail.no-personal-data",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: no personal data",
      "category_reason": "A guardrail is a reusable rule every verb in this work follows, with the check that proves it.",
      "value": {
        "rule": "Collect and keep no personal data. Leave out names, contact details and case details, even when a public source shows them.",
        "how_it_is_checked": "No output holds a name of a private person, a phone number, an email address or a street address."
      }
    },
    {
      "slug": "guardrail.cite-every-claim",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: a citation for every claim",
      "category_reason": "A guardrail is a reusable rule every verb in this work follows, with the check that proves it.",
      "value": {
        "rule": "Every claim carries a citation to the exact clause, page or line it comes from. A claim without a citation is removed, not softened.",
        "how_it_is_checked": "Every point or figure in an output lists at least one citation that resolves in the cited source."
      }
    },
    {
      "slug": "guardrail.person-decides",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: a person decides",
      "category_reason": "A guardrail is a reusable rule every verb in this work follows, with the check that proves it.",
      "value": {
        "rule": "Workers find, extract, draft and review. A person decides what is delivered, and what anyone does with it.",
        "how_it_is_checked": "Every delivery record is submitted by a person's key, never by a worker that drafted or reviewed the output."
      }
    },
    {
