              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
