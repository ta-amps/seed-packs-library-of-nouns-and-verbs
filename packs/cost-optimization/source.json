              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "unknown_reason": {
              "type": "string",
              "minLength": 0,
              "maxLength": 300
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$"
            },
            "plan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "source_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^https://"
            },
            "read_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}",
              "maxLength": 40
            },
            "notes": {
              "type": "string",
              "minLength": 0,
              "maxLength": 300
            }
          }
        },
        "rules": [
          "read_at is the date the page was read.",
          "A price that is not public is null with unknown_reason; prices behind a login are out of scope."
