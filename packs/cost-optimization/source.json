        "example": {
          "provider": "SYNTHETIC cloud",
          "item": "rows written",
          "unit": "1 million rows",
          "price": 1.0,
          "currency": "USD",
          "plan": "SYNTHETIC paid plan",
          "source_url": "https://example.invalid/synthetic/pricing",
          "read_at": "2026-10-29"
        }
      },
      "category_reason": "A price card is a dated snapshot of a public source."
    },
