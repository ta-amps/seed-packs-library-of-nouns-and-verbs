{
  "pack_id": "cost-optimization",
  "title": "Cost optimization",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for finding and measuring cost savings: ledgers from supplied usage and dated prices, savings proposed with arithmetic, before-and-after measurements and recommendations for the owner, keeping billed, measured, estimated and credit apart.",
  "dependencies": [
    "evaluation-design"
  ],
  "boundaries": [
    "Never change plans, settings, resources or model choices. Recommendations are for the owner to act on.",
    "Read only usage and invoices the requester supplied or exported. Do not open billing dashboards or credential files.",
    "Keep the caller's chosen model and output settings. A cheaper setting is a trade-off to measure, not a default.",
    "Importing the pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for finding and measuring cost savings",
      "value": {
        "lets_workers": "Find where a project's money goes and how to spend less without breaking anything: build a ledger from supplied usage and dated prices, propose savings with their arithmetic, measure the promising ones before and after, and recommend changes for the owner to make.",
        "flow": [
          {
            "verb": {
              "$verb": "cost-optimization.inventory-costs"
            },
            "when": "First, from usage and invoices the requester supplied."
          },
          {
            "verb": {
              "$verb": "cost-optimization.price-check"
            },
            "when": "For ledger lines without a dated price."
          },
          {
            "verb": {
              "$verb": "cost-optimization.propose-savings"
            },
            "when": "After the ledger exists."
          },
          {
            "verb": {
              "$verb": "cost-optimization.measure-saving"
            },
            "when": "For savings worth confirming; two runs each, before and after."
          },
          {
            "verb": {
              "$verb": "cost-optimization.recommend"
            },
            "when": "After measurements, or directly for obvious estimates labeled as such."
          },
          {
            "verb": {
              "$verb": "cost-optimization.review-recommendation"
            },
            "when": "Last, by a different worker."
          }
        ],
        "relationship": "Repository review's cost family finds cost questions in code; this pack goes deeper with ledgers and measurements.",
        "rules": [
          "Never change plans, settings, resources or model choices. Recommendations are for the owner to act on.",
          "Read only usage and invoices the requester supplied or exported. Do not open billing dashboards or credential files.",
          "Keep the caller's chosen model and output settings. A cheaper setting is a trade-off to measure, not a default."
        ]
      },
      "relations": [
        [
          "requires_noun",
          "method"
        ],
        [
          "requires_noun",
          "template.cost-ledger"
        ],
        [
          "requires_noun",
          "template.price-card"
        ],
        [
          "requires_noun",
          "template.saving-hypothesis"
        ],
        [
          "requires_noun",
          "template.saving-result"
        ],
        [
          "requires_noun",
          "template.recommendation"
        ],
        [
          "requires_noun",
          "template.review"
        ]
      ]
    },
    {
      "slug": "method",
      "category": "noun.skill_pack",
      "role": "method",
      "title": "Cost method: separate billed, measured, estimated and credit",
      "category_reason": "A reusable method with its guardrails, used by every verb in this pack.",
      "value": {
        "rules": [
          "Keep four kinds of numbers apart: billed (from an invoice), measured (from usage counters), estimated (arithmetic on stated assumptions) and credit.",
          "Every price has a source URL and the date it was read; plans and prices change.",
          "Unknown amounts stay null; never fill a gap with zero.",
          "A saving counts only if quality, reliability and security hold; measure them with the same runs.",
          "Keep the caller's chosen model and output settings. A cheaper setting is a trade-off to measure, not a default.",
          "Never change plans, settings, resources or model choices. Recommendations are for the owner to act on.",
          "Read only usage and invoices the requester supplied or exported. Do not open billing dashboards or credential files."
        ],
        "measurement": {
          "$pin": "evaluation-design:method"
        }
      },
      "relations": [
        [
          "requires_noun",
          "evaluation-design:method"
        ]
      ]
    },
    {
      "slug": "template.cost-ledger",
      "category": "noun.eval_run",
      "role": "template",
      "title": "Template: a cost ledger for one period: each line's unit, quantity, price, amount, basis and source",
      "value": {
        "describes": "a cost ledger for one period: each line's unit, quantity, price, amount, basis and source",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "period",
            "currency",
            "lines",
            "total_by_basis"
          ],
          "properties": {
            "period": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}",
                  "maxLength": 40
                },
                "end": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}",
                  "maxLength": 40
                }
              }
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$"
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service",
                  "unit",
                  "quantity",
                  "unit_price",
                  "amount",
                  "basis",
                  "source"
                ],
                "properties": {
                  "service": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "quantity": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "unit_price": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "amount": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "enum": [
                      "billed",
                      "measured",
                      "estimated",
                      "credit"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "price_card_ref": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 300
                  }
                }
              }
            },
            "total_by_basis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "billed",
                "measured",
                "estimated",
                "credit"
              ],
              "properties": {
                "billed": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "measured": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "estimated": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "credit": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "rules": [
          "Totals are kept per basis, never mixed.",
          "A line without a price has amount null."
        ]
      },
      "category_reason": "A ledger is a null-honest scorecard of spend with its sources."
    },
    {
      "slug": "template.price-card",
      "category": "noun.public_source",
      "role": "template",
      "title": "Template: one dated price from a provider's public pricing page",
      "value": {
        "describes": "one dated price from a provider's public pricing page",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
