": 10}, "segment": {"type": "string", "minLength": 1, "maxLength": 120}, "min_share": {"type": "number", "minimum": 0, "maximum": 1}}}}, "criteria_fixed_on": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "first_session_on": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}, "status": "proposal", "admission": "not_admitted", "content_kind": "authored_guidance", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "reason": "Tessera requires these axes, so each is set to its lowest value and the tier is unverified. No quality is claimed. Replace them only with measured values and the evidence that produced them."}, "relations": []}},
{"store": "seedpack.video-uat", "key": "video-uat.v0.1.0.template.session-notes", "expected_version": 0, "producer_surface": "surface:tessera", "visibility_scope": "surface_only", "allowed_surfaces": [], "target_cohorts": ["all"], "tags": ["category:noun.eval_run", "pack:video-uat", "role:template", "content:authored", "spdx:MIT", "status:quarantined"], "value": {"category_id": "noun.eval_run", "role": "template", "pack": "video-uat", "pack_version": "0.1.0", "title": "Template: one session's notes", "describes": "one pseudonymous viewer's session: segment, consent, how they watched, and their answers per task in their own words, with times for any moment they pointed to", "schema": {"type": "object", "additionalProperties": false, "required": ["viewer", "segment", "consent", "watched", "answers", "recorded_media"], "properties": {"viewer": {"type": "string", "minLength": 1, "maxLength": 10, "pattern": "^V[0-9]{2,3}$"}, "segment": {"type": "string", "minLength": 1, "maxLength": 120}, "consent": {"type": "boolean"}, "watched": {"type": "string", "enum": ["with_sound", "muted"]}, "answers": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "answer", "time_s"], "properties": {"task_id": {"type": "string", "minLength": 1, "maxLength": 10}, "answer": {"type": "string", "minLength": 0, "maxLength": 600}, "time_s": {"type": ["number", "null"], "minimum": 0, "maximum": 86400}}}}, "recorded_media": {"type": "boolean"}}}, "status": "proposal", "admission": "not_admitted", "content_kind": "authored_guidance", "license": "MIT", "provenance": {"source": "original ta-amps authored proposal", "license": "MIT", "generator": "scripts/build_packs.py", "independently_verified": false}, "dimensions": {"determinism": 0.0, "evidence_grounding": 0.0, "token_efficiency": 0.0, "safety_compliance": 0.0, "verification_tier": "unverified"}, "dimension_basis": {"measured": false, "method": "unmeasured_floor", "rea