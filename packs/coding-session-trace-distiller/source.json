{
  "pack_id": "coding-session-trace-distiller",
  "title": "Coding session trace distiller",
  "version": "0.1.0",
  "summary": "A collection of nouns and verbs for mining sanitized multi-hour AI coding session JSONL transcripts into reusable failure tombstones, tool-error loops, verified fix recipes, and prompt-shim candidates, with tested standard-library Python code.",
  "boundaries": [
    "Every transcript is scrubbed for credentials, personal email addresses, and workstation home paths before mining.",
    "An edit without both an earlier failing check and a later passing check is never recorded as a verified fix recipe.",
    "Prompt shims remain candidate proposals until an owner reviews and admits them.",
    "Workers create nouns and propose verbs; importing this pack writes nothing and enqueues nothing."
  ],
  "nouns": [
    {
      "slug": "pack",
      "category": "noun.skill_pack",
      "role": "pack",
      "title": "A collection of nouns and verbs for distilling coding session JSONL traces into verified operational knowledge",
      "value": {
        "lets_workers": "Scrub raw coding-session JSONL transcripts locally, detect repeated tool-error loops, extract dead-end failure tombstones, isolate fix recipes verified by passing checks, and draft bounded prompt-shim candidates.",
        "not_for": "Training model weights, grading individual engineers, or exporting unredacted transcripts.",
        "flow": [
          {
            "verb": {
              "$verb": "coding-session-trace-distiller.redact-session-trace"
            },
            "when": "First: scrub secrets, personal addresses, and home paths from local JSONL."
          },
          {
            "verb": {
              "$verb": "coding-session-trace-distiller.mine-error-loops-and-tombstones"
            },
            "when": "Find repeated tool-call failure streaks and abandoned approaches."
          },
          {
            "verb": {
              "$verb": "coding-session-trace-distiller.extract-verified-fix-recipes"
            },
            "when": "Isolate failing-check to edit to passing-check sequences."
          },
          {
            "verb": {
              "$verb": "coding-session-trace-distiller.draft-prompt-shim-candidates"
            },
            "when": "Turn preventable loops and tombstones into scoped guard instructions."
          },
          {
            "verb": {
              "$verb": "coding-session-trace-distiller.compile-distillation-report"
            },
            "when": "Combine counts, tombstones, verified fixes, and shims into one checked report."
          }
        ],
        "guardrails": [
          {
            "$pin": "guardrail.redact-before-distill"
          },
          {
            "$pin": "guardrail.verified-fix-needs-check"
          },
          {
            "$pin": "guardrail.shims-stay-proposals"
          }
        ],
        "tool": {
          "$pin": "tool.session-distiller"
        }
      },
      "relations": [
        [
          "requires_noun",
          "method"
        ],
        [
          "requires_noun",
          "guardrail.redact-before-distill"
        ],
        [
          "requires_noun",
          "guardrail.verified-fix-needs-check"
        ],
        [
          "requires_noun",
          "guardrail.shims-stay-proposals"
        ],
        [
          "requires_noun",
          "rules.trace-redaction-and-loops"
        ],
        [
          "requires_noun",
          "tool.session-distiller"
        ],
        [
          "requires_noun",
          "template.distillation-report"
        ]
      ]
    },
    {
      "slug": "method",
      "category": "noun.skill_pack",
      "role": "method",
      "title": "Method: sanitize first, then separate dead ends from verified fixes",
      "category_reason": "Reusable multi-step procedure governing every verb in the pack.",
      "value": {
        "lifecycle": [
          "redact-session-trace normalizes paths and strips credentials and personal addresses before any analysis.",
          "mine-error-loops-and-tombstones groups consecutive failures with matching tool and normalized error signature.",
          "extract-verified-fix-recipes pairs failing verification runs with subsequent edits and passing verification runs.",
          "draft-prompt-shim-candidates writes concise precondition guards backed by loop or tombstone identifiers.",
          "compile-distillation-report validates the combined report against deterministic record checks."
        ]
      }
    },
    {
      "slug": "guardrail.redact-before-distill",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: sanitize credentials, addresses, and home paths before mining",
      "value": {
        "rule": "No raw session transcript line enters a tombstone, fix recipe, or shim candidate prior to deterministic credential, email, and workstation-path scrubbing.",
        "how_it_is_checked": "session_distiller.redact_session runs first and records redaction_counts plus sanitized_events_sha256."
      }
    },
    {
      "slug": "guardrail.verified-fix-needs-check",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: a fix recipe requires a failing check followed by an edit and passing check",
      "value": {
        "rule": "Edits lacking either an earlier failing check or a subsequent passing check are classified as unverified_edits and excluded from verified_fix_recipes.",
        "how_it_is_checked": "extract_verified_fix_recipes enforces the three-stage state transition deterministically."
      }
    },
    {
      "slug": "guardrail.shims-stay-proposals",
      "category": "noun.skill_pack",
      "role": "guardrail",
      "title": "Guardrail: mined prompt shims remain unactivated candidate proposals",
      "value": {
        "rule": "Mined prompt-shim candidates never mutate active system prompts automatically; each records supporting loop ids for human review.",
        "how_it_is_checked": "Every candidate carries status candidate_proposal and supporting_loop_ids."
      }
    },
    {
      "slug": "rules.trace-redaction-and-loops",
      "category": "noun.reflex_procedure",
      "role": "rules",
      "title": "Deterministic rules for error-signature normalization, loop streaks, and fix gating",
      "value": {
        "error_normalization": "Take the first non-empty error line, replace line numbers with 'line N' and hex pointers with '0xADDR'.",
        "loop_threshold": "Two or more unbroken failures of the same tool with identical normalized error signature form a loop; wasted_steps = repeat_count - 1.",
        "fix_state_machine": "failing_check -> one or more non-reverted file edits -> passing_check."
      }
    },
    {
      "slug": "template.sanitized-trace",
      "category": "noun.eval_run",
      "role": "template",
      "title": "Template: sanitized session trace digest and redaction counters",
      "value": {
        "describes": "a scrubbed coding-session JSONL summary with redaction counters and event digest",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "event_count",
            "sanitized_events_sha256",
            "redaction_counts"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "event_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "sanitized_events_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "redaction_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "secrets_redacted",
                "emails_redacted",
                "paths_normalized"
              ],
              "properties": {
                "secrets_redacted": {
                  "type": "integer",
                  "minimum": 0
                },
                "emails_redacted": {
                  "type": "integer",
                  "minimum": 0
                },
                "paths_normalized": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    {
