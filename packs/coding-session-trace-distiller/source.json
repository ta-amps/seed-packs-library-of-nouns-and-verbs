      "category": "noun.code_node",
      "role": "tool_card",
      "title": "Tool card: session_distiller standard-library CLI and library",
      "value": {
        "name": "session_distiller",
        "code": {
          "$code": "coding-session-trace-distiller"
        },
        "runtime": "Python 3.10 or later, standard library only.",
        "commands": [
          "python3 -m session_distiller redact SESSION.jsonl",
          "python3 -m session_distiller distill SESSION.jsonl [--session-id ID] [--min-loop-repeats 2]"
        ],
        "does": [
          "Scrubs bearer tokens, API keys, private key blocks, personal emails, and home paths.",
          "Finds consecutive tool-error streaks, dead-end tombstones, verified fix recipes, and candidate prompt shims."
        ],
        "does_not": [
          "Open network sockets, call models, or mutate the input transcript."
        ],
        "code_license": "MIT"
