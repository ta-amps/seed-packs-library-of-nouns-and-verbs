    {
      "slug": "distillation-checks",
      "category": "noun.benchmark_suite",
      "role": "record_checks",
      "title": "Deterministic record checks for distilled session reports",
      "value": {
        "fixture_kind": "finding_checks",
        "purpose": "Deterministic checks every distilled coding-session report must satisfy before review.",
        "deterministic_checks": [
          {
            "id": "digest-pinned",
            "rule": {
              "rule": "pattern_present",
              "path": "sanitized_events_sha256",
              "pattern": "^[0-9a-f]{64}$"
            },
            "why": "Every report pins the SHA-256 digest of the sanitized JSONL event stream."
          },
          {
            "id": "home-paths-scrubbed",
            "rule": {
              "rule": "pattern_absent",
              "path": "$",
              "pattern": "/home/[a-z0-9_]+"
            },
            "why": "Workstation home directories must be normalized to <HOME> before distillation."
          },
          {
            "id": "fixes-have-steps",
            "rule": {
              "rule": "each_has",
              "path": "verified_fix_recipes",
              "fields": [
                "recipe_id",
                "failing_command",
                "verification_command"
              ],
              "min": 1
            },
            "why": "Each verified fix names both its failing reproduction command and passing check."
          },
          {
            "id": "hosts-local",
            "rule": {
              "rule": "hosts_local_only",
              "path": "$"
            },
            "why": "Synthetic and local session reports must not embed external host endpoints."
          }
        ],
        "golden_fixtures": [
          {
            "id": "good-distilled-report",
            "label": "known_good",
            "finding": {
              "session_id": "synth-session-01",
              "event_count": 6,
              "sanitized_events_sha256": "4b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c",
              "verified_fix_recipes": [
                {
                  "recipe_id": "FIX-1a2b3c4d5e",
                  "failing_command": "python3 -m unittest",
                  "verification_command": "python3 -m unittest"
                }
              ],
              "note": "Tested locally against http://127.0.0.1:8000 health check in <HOME>/repo."
            }
          },
          {
            "id": "bad-unscrubbed-home-path",
            "label": "known_bad",
            "finding": {
              "session_id": "synth-session-02",
              "event_count": 4,
              "sanitized_events_sha256": "4b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c",
              "verified_fix_recipes": [
                {
                  "recipe_id": "FIX-1a2b3c4d5e",
                  "failing_command": "pytest /home/devuser/project/tests",
                  "verification_command": "pytest <HOME>/project/tests"
                }
              ]
            }
          },
          {
            "id": "bad-missing-verification-cmd",
            "label": "known_bad",
            "finding": {
              "session_id": "synth-session-03",
              "event_count": 3,
              "sanitized_events_sha256": "4b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c",
              "verified_fix_recipes": [
                {
                  "recipe_id": "FIX-9999999999",
                  "failing_command": "python3 -m unittest",
                  "verification_command": ""
                }
              ]
            }
          }
        ],
        "expected": {
          "good-distilled-report": {
            "verdict": "pass",
            "failed_checks": []
          },
          "bad-unscrubbed-home-path": {
            "verdict": "fail",
            "failed_checks": [
              "home-paths-scrubbed"
            ]
          },
          "bad-missing-verification-cmd": {
            "verdict": "fail",
            "failed_checks": [
              "fixes-have-steps"
            ]
          }
        }
      }
    },
    {
